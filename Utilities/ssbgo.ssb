## SSBGO_SSB
## Author:   Timothy Swenson
## Date Created: 20 Aug 1998
## Date Revised: 20 Mar 2016
## Version 1.3 records development; separate executable
##
## This program will take an arguement of a SSB program
## run it through SSB, load it in to SuperBasic,
## then execute Qlib compiler.
##
## The idea is to edit an SSB program, save the file,
## and from within the editor (like MicroEmacs) execute
## SSBGO, wait a while, and then you will have a final
## executable.
##
## This program uses 'grep' to check for MIStakes found in
## SuperBASIC programs after they have been loaded, the
## programmer should not use the word 'MIStake' in
## their program.
##
## Requires:  TURBO Toolkit (TTK) 3f32
##            Toolkit II (TKII)
##            Environment Variables (env_bin)
##
## This program assumes that a RAM1_ does exist.
##
## The following are user changable options.
##
##   Compiler           1 Char ( "T" or "Q")
##   Qlib Arguments     20 Char
##   Input File Ext.    4 Char
##   Output File Ext.   4 Char
##   ssb exec directory 20 char

## TURBO Defines
TURBO_taskn "ssbgo records dev"
TURBO_objfil "ram1_ssbgorecdev_exe"
TURBO_windo 1
TURBO_repfil "ram1_err"
TURBO_objdat 400
TURBO_buffersz 400
TURBO_optim 0
TURBO_diags 2
TURBO_locstr 1
TURBO_struct 0

DIM compiler$(1), qlib_arg$(20), inputext$(4)
DIM outputext$(100), execdir$(100), filter$(100)
DIM work$(100),work2$(100),basfile$(100),backup$(100),candidate$(1024)


## Get command line
filename$ = OPTION_CMD$

## Make sure only one argument
IF ( " " INSTR filename$ ) THEN
   BEEP 1000,10
   STOP
END IF

## Set default options

compiler$ = "T"
qlib_arg$ = ""
inputext$ = "_ssb"
outputext$ = "_bas"
execdir$ = ""


## Get options from ENV statement(s)

temp$ = GETENV$("SSBCOMPILER")
IF temp$ <> "" THEN compiler$ = temp$
temp$ = GETENV$("SSBQLIBARG")
IF temp$ <> "" THEN qlib_arg$ = temp$
temp$ = GETENV$("SSBINPUTEXT")
IF temp$ <> "" THEN inputext$ = temp$
IF GETENV$("SSBINPUT")="" THEN SETENV "SSBINPUT=" & inputext$
temp$ = GETENV$("SSBOUTPUTEXT")
IF temp$ <> "" THEN outputext$ = temp$
temp$=GETENV$("SSBOUTPUT")
IF temp$<>"" THEN outputext$=temp$
IF GETENV$("SSBOUTPUT")="" THEN SETENV "SSBOUTPUT=" & outputext$
temp$ = GETENV$("SSBEXEC")
IF temp$ <> "" THEN execdir$ = temp$


## Match the filter's actual output path, including working-directory overrides.
filter$=GETENV$("SSBFILTER"): IF filter$="" THEN filter$="ssb"
work$=GETENV$("SSBWORK"): work2$=GETENV$("SSBWORK2")
IF work2$="" THEN work2$=work$
candidate$=work2$ & filename$ & outputext$
IF LEN(candidate$)>100 THEN PRINT "SSBGO: output path exceeds 100 bytes": STOP
basfile$=candidate$
status=FTEST(basfile$)
IF status<>0 AND status<>-7 THEN PRINT "SSBGO: cannot access output ";status: STOP
IF status=0 THEN
  temp$=GETENV$("SSBOVER")
  IF NOT (temp$=="Y" OR temp$=="S") THEN
    PRINT "SSBGO: existing output; set SSBOVER=Y to authorize replacement"
    STOP
  END IF
  backup$=""
  FOR backupnum=1 TO 999
    candidate$=basfile$ & "_go" & backupnum
    IF LEN(candidate$)>100 THEN PRINT "SSBGO: backup name too long": STOP
    IF FTEST(candidate$)=-7 THEN backup$=candidate$: EXIT backupnum
  END FOR backupnum
  IF backup$="" THEN PRINT "SSBGO: no unused backup name": STOP
  RENAME basfile$,backup$
  IF FTEST(basfile$)<>-7 OR FTEST(backup$)<>0 THEN PRINT "SSBGO: cannot preserve output": STOP
  PRINT "SSBGO: previous output retained as ";backup$
END IF

EXEC_W execdir$ & filter$;filename$

## Check to make sure that SSB finished without any
## errors.  We do this my making sure that the
##  _bas file exists.
##

IF FTEST(basfile$) <> 0 THEN
   BEEP 1000,10
   STOP
ENDIF

## Load the program into SuperBasic
## Both Qliberator and TURBO compiler programs from memory
## (meaning they are LOADed into the SuperBASIC interpreter.

COMMAND_LINE

cmd$ = "LOAD "&basfile$&CHR$(10)
TYPE_IN cmd$

## Save the program so we can check for MISTakes
## Key is CTRL-SHIFT-A

cmd$="SAVE_O "&basfile$&CHR$(10)
TYPE_IN cmd$

DELETE "ram1_ssbgo_out"

## Use grep to look for any lines with MISTake
EW execdir$&"grep";"MISTake "&basfile$&" > ram1_ssbgo_out"

## Make sure grep did not find anything
IF FLEN(\"ram1_ssbgo_out") <> 0 THEN
   BEEP 1000,10
   VIEW "ram1_ssbgo_out"
   STOP
END IF

DELETE ram1_ssbgo_out

## Execute Qliberator or TURBO in command line mode

IF compiler$ = "Q" THEN
   cmd$ = "liberate "&basfile$&",'-OBJ" \+
    &filename$&" "&qlib_arg$&"'"&CHR$(10)
   TYPE_IN cmd$
END IF

IF compiler$ = "T" THEN
   cmd$="CHARGE \"&CHR$(10)
   TYPE_IN cmd$
END IF

END_CMD
## Since QLIB or TURBO is the last thing run, we don't care
## if it has any errors because we are basically done.

