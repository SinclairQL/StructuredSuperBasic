982 DEFine PROCedure rec_descriptor(a,b,formal)
983   LOCal i,j,last,rs_b(64),rs_e(64),rs_n,asat
984   rd_name$=rec_token$(a): rd_shape$="": rd_rank=0: rd_type=0: rd_val=0: rd_pool=0
985   IF rec_upper$(rd_name$)="VAL" THEN
986     rd_val=1: a=a+1: rd_name$=rec_token$(a)
987   END IF
988   IF rk_kind(a)<>1 THEN rec_fail "Expected a declared name"
989   IF LEN(rd_name$)>64 THEN rec_fail "Declared names are limited to 64 bytes"
990   i=a+1
991   IF i<=b THEN
992     IF rec_token$(i)="(" THEN
993       j=rec_match(i,b): rd_shape$=rec_part$(i+1,j-1)
994       IF formal THEN
995         FOR last=i+1 TO j-1
996           IF rec_token$(last)<>"," THEN rec_fail "Record array formals use empty dimensions"
997         END FOR last
998         rd_rank=1
999         FOR last=i+1 TO j-1
1000           rd_rank=rd_rank+1
1001         END FOR last
1002       ELSE
1003         rec_split i+1,j-1: rd_rank=rs_n
1004         IF NOT rs_n THEN rec_fail "Record storage arrays need dimension bounds"
1005       END IF
1006       i=j+1
1007     END IF
1008   END IF
1009   IF i<=b THEN
1010     IF rec_upper$(rec_token$(i))<>"AS" OR i+1>b THEN rec_fail "Expected AS recordType"
1011     rd_type=rec_typeid(rec_token$(i+1)): i=i+2
1012   END IF
1013   IF i<=b THEN
1014     IF rec_upper$(rec_token$(i))<>"POOL" OR i<>b THEN rec_fail "Unexpected text after record declaration"
1015     rd_pool=1: i=i+1
1016   END IF
1017   IF rd_val AND (rd_type OR rd_rank) THEN rec_fail "VAL supports scalar numbers and strings only"
1018   IF rd_pool AND (formal OR NOT rd_type OR rd_rank<>1) THEN rec_fail "POOL requires a global one-dimensional record array"
1019 END DEFine rec_descriptor
1020 DEFine PROCedure rec_collect(text$)
1021   LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
1022   LOCal rs_b(64),rs_e(64),rs_n,i,j,k,a,b,kind$(1024),name$(1024),n,v
1023   LOCal rd_name$(64),rd_shape$(1024),rd_rank,rd_type,rd_val,rd_pool
1024   rec_lex text$
1025   IF rk_n=0 THEN RETurn
1026   kind$=rec_upper$(rec_token$(1))
1027   IF rk_kind(1)=5 OR kind$=CHR$(64) THEN RETurn
1028   b=rk_n: IF rk_kind(b)=5 THEN b=b-1
1029   IF kind$="TYPE" THEN
1030     IF rc_type OR rc_routine OR b<>2 THEN rec_fail "TYPE must be a top-level declaration"
1031     rc_type=rec_typeid(rec_token$(2))
1032     IF rt_defined(rc_type) THEN rec_fail "Duplicate TYPE: " & rec_token$(2)
1033     rt_defined(rc_type)=1: RETurn
1034   END IF
1035   IF kind$="END" AND rec_upper$(rec_token$(2))="TYPE" THEN
1036     IF NOT rc_type THEN rec_fail "END TYPE without TYPE"
1037     rc_type=0: RETurn
1038   END IF
1039   IF kind$="REFERENCE" AND NOT rc_type THEN
1040     RETurn
1041   END IF
1042   IF rc_type THEN
1043     rec_descriptor 1,b,0
1044     IF rd_val OR rd_pool THEN rec_fail "Invalid TYPE field"
1045     FOR i=1 TO rf_n
1046       IF rf_owner(i)=rc_type AND rec_upper$(rf_name$(i))=rec_upper$(rd_name$) THEN rec_fail "Duplicate field: " & rd_name$
1047     END FOR i
1048     rec_room rf_n,rc_cap,"Field"
1049     rf_n=rf_n+1: rf_owner(rf_n)=rc_type: rf_name$(rf_n)=rec_upper$(rd_name$): rf_type(rf_n)=rd_type
1050     IF rd_type THEN
1051       IF rd_rank THEN rec_fail "Arrays of embedded records are not supported"
1052     ELSE
1053       IF rd_name$(LEN(rd_name$))="$" AND NOT rd_rank THEN rec_fail "String fields require a capacity"
