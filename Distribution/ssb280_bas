1473 DEFine FuNction rec_arguments$(routine,text$,expression)
1474   LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
1475   LOCal rs_b(64),rs_e(64),rs_n,i,j,p,v,n,sel$(1024),prefix$(160),result$(1024),actual$(1024),needs,effect,before
