1791       rec_put s$ & ":": remaining$=rec_part$(cut+1,rk_n): GO TO 1726
1792     END IF
1793     IF kind$="FOR" OR kind$="REPEAT" OR kind$="REP" THEN
1794       FOR j=cut+1 TO b-1
1795         IF rec_upper$(rec_token$(j))="END" THEN
1796           IF rec_upper$(rec_token$(j+1))=kind$ THEN rec_fail "Use multiline form for explicitly closed inline loops"
1797         END IF
1798       END FOR j
1799       s$=rec_token$(2)
1800       IF kind$="FOR" THEN
1801         j=3
1802         REPeat rec_counter_end
1803           IF j>=cut THEN rec_fail "FOR counter requires an assignment"
1804           IF rec_token$(j)="=" THEN EXIT rec_counter_end
1805           j=j+1
1806         END REPeat rec_counter_end
1807         s$=rec_part$(2,j-1)
1808       END IF
1809       rec_statement rec_part$(1,cut-1)
1810       rec_statement rec_part$(cut+1,rk_n)
1811       rec_put "END " & rec_token$(1) & " " & rec_expr$(s$): RETurn
1812     END IF
1813     IF cut>1 THEN rec_statement rec_part$(1,cut-1)
1814     IF cut<rk_n THEN remaining$=rec_part$(cut+1,rk_n): GO TO 1726
1815     RETurn
1816   END IF
1817   IF kind$="DIM" OR kind$="LOCAL" THEN
1818     rec_split 2,b
1819     FOR i=1 TO rs_n
1820       k=0
1821       FOR j=rs_b(i) TO rs_e(i)
1822         IF rec_upper$(rec_token$(j))="AS" THEN k=1
1823       END FOR j
1824       IF k THEN
1825         rec_descriptor rs_b(i),rs_e(i),0
1826         v=rec_find(rd_name$,rv_name$,rv_n)
1827         rec_storage v,rd_shape$,rd_pool
1828       ELSE
1829         s$=rec_part$(rs_b(i),rs_e(i))
1830         IF rec_find(rec_token$(rs_b(i)),rv_name$,rv_n) THEN rec_fail "Cannot independently dimension record storage"
1831         rec_put rec_token$(1) & " " & rec_expr$(s$)
1832       END IF
1833     END FOR i
1834     RETurn
1835   END IF
1836   rec_view 1,b
1837   IF vw_var AND NOT vw_leaf THEN
1838     i=vw_end+1
1839     IF i>b OR rec_token$(i)<>"=" THEN rec_fail "Whole record requires an assignment or typed parameter"
1840     rec_copy rec_part$(1,vw_end),rec_part$(i+1,b): RETurn
1841   END IF
1842   v=rec_find(rec_token$(1),rr_name$,rr_n)
1843   IF v AND NOT rr_fun(v) THEN
1844     i=2: j=b
1845     IF i<=b AND rec_token$(i)="(" THEN
1846       k=rec_match(i,b)
1847       IF k=b THEN j=k-1: i=i+1
1848     END IF
1849     s$=rec_arguments$(v,rec_part$(i,j),0)
1850     IF s$<>"" THEN s$=" " & s$
1851     rec_put rec_token$(1) & s$: RETurn
1852   END IF
1853   IF kind$="FOR" THEN
1854     rec_view 2,b
1855     IF vw_var AND (NOT vw_leaf OR vw_sel$<>"") THEN rec_fail "FOR counter must be a simple scalar field"
1856     IF vw_leaf THEN
1857       IF rl_rank(vw_leaf)<>0 OR rec_isstring(rl_path$(vw_leaf)) THEN rec_fail "FOR counter must be a numeric scalar field"
1858     END IF
1859   END IF
1860   IF kind$="PRINT" OR kind$="RETURN" OR kind$="RET" THEN
1861     before=rc_temp: s$=rec_expr$(rec_part$(2,rk_n))
1862     rec_put rec_token$(1) & " " & s$: RETurn
1863   END IF
1864   IF b>2 AND rk_kind(1)=1 AND rec_token$(2)="=" THEN
1865     rec_put rec_token$(1) & " = " & rec_expr$(rec_part$(3,rk_n)): RETurn
1866   END IF
1867   rec_put rec_expr$(remaining$)
1868 END DEFine rec_statement
