2102 DEFine PROCedure rec_lex(text$)
2103   LOCal i,j,c$(160),q$(1),depth
2104   rk_line$=text$: rk_n=0: i=1
2105   REPeat rec_scan
2106     IF i>LEN(text$) THEN EXIT rec_scan
2107     c$=text$(i)
2108     IF c$=" " OR c$=CHR$(9) THEN i=i+1: NEXT rec_scan
2109     IF rk_n=256 THEN rec_fail "Too many tokens on one line"
2110     rk_n=rk_n+1: rk_s(rk_n)=i: rk_kind(rk_n)=4
2111     j=i
2112     IF c$='"' OR c$="'" THEN
2113       rk_kind(rk_n)=3: q$=c$: j=i+1
2114       REPeat rec_quote
2115         IF j>LEN(text$) THEN rec_fail "Unterminated quoted string"
2116         IF text$(j)=q$ THEN EXIT rec_quote
2117         j=j+1
2118       END REPeat rec_quote
2119     ELSE
2120       IF rec_letter(c$) THEN
2121         rk_kind(rk_n)=1
2122         REPeat rec_ident
2123           IF j=LEN(text$) THEN EXIT rec_ident
2124           IF NOT rec_namechar(text$(j+1)) THEN EXIT rec_ident
2125           j=j+1
2126         END REPeat rec_ident
2127         IF j<LEN(text$) THEN
2128           IF text$(j+1)="$" OR text$(j+1)="%" THEN j=j+1
2129         END IF
2130       ELSE
2131         IF rec_digit(c$) OR c$="$" OR c$="%" THEN
2132           rk_kind(rk_n)=2
2133           REPeat rec_number
2134             IF j=LEN(text$) THEN EXIT rec_number
2135             c$=rec_upper$(text$(j+1))
2136             IF NOT rec_namechar(c$) AND c$<>"." THEN EXIT rec_number
2137             j=j+1
2138             IF c$="E" AND j<LEN(text$) THEN
2139               IF text$(j+1)="+" OR text$(j+1)="-" THEN j=j+1
2140             END IF
2141           END REPeat rec_number
2142         END IF
2143       END IF
2144     END IF
2145     rk_e(rk_n)=j
2146     IF rk_kind(rk_n)=3 THEN
2147       rk_len%(rk_n)=1
2148     ELSE
2149       IF j-i>159 THEN rec_fail "Identifier/number token exceeds 160 bytes"
2150       rk_len%(rk_n)=j-i+1
2151     END IF
2152     c$=rec_upper$(rec_token$(rk_n))
2153     IF c$="REMARK" OR c$="REM" OR c$="DATA" THEN
2154       rk_e(rk_n)=LEN(text$): rk_len%(rk_n)=LEN(c$): rk_kind(rk_n)=5
2155       EXIT rec_scan
2156     END IF
2157     IF j<LEN(text$) THEN
2158       c$=text$(j TO j+1)
2159       IF c$="##" OR c$="**" THEN
2160         rk_e(rk_n)=LEN(text$): rk_len%(rk_n)=LEN(c$): rk_kind(rk_n)=5
2161         EXIT rec_scan
2162       END IF
2163     END IF
2164     i=j+1
2165   END REPeat rec_scan
2166 END DEFine rec_lex
