760 DEFine PROCedure rec_select(source$,channel)
761   LOCal text$(1000),next$(1000),raw$(1000),sourceLine,origin,i,j,key$(64),symbol$(100),savedif
762   IF channel>23 THEN rec_fail "Include depth exceeds reserved input channels 5..23"
763   IF FOP_IN(#channel,source$)<0 THEN rec_fail "Cannot open include/source: " & source$
764   file_num=channel: sourceLine=0: savedif=rc_ifn
765   REPeat rec_read_source
766     IF EOF(#channel) THEN EXIT rec_read_source
767     INPUT #channel,text$: sourceLine=sourceLine+1: origin=sourceLine
768     text$=stripTab$(text$)
769     REPeat rec_join_source
770       IF LEN(text$)<2 THEN EXIT rec_join_source
771       IF text$(LEN(text$)-1 TO)<>"\+" THEN EXIT rec_join_source
772       IF EOF(#channel) THEN rec_fail "Continuation at end of file"
773       INPUT #channel,next$: sourceLine=sourceLine+1
774       text$=text$(TO LEN(text$)-2) & " " & rec_ltrim$(next$)
775       IF LEN(text$)>1000 THEN rec_fail "Joined source sourceLine exceeds 1000 bytes"
776     END REPeat rec_join_source
777     rc_file$=source$: rc_line=origin
778     raw$=rec_trim$(text$)
779     IF raw$="" THEN
780       IF rc_active AND d_ignore$<>"Y" THEN rec_spoolline text$
781       NEXT rec_read_source
782     END IF
783     IF raw$(1)="." THEN NEXT rec_read_source
784     IF raw$(1)="#" AND raw$(1 TO 2)<>"##" THEN
785       i=" " INSTR raw$: IF NOT i THEN i=LEN(raw$)+1
786       key$=rec_upper$(raw$(1 TO i-1)): symbol$=""
787       IF i<LEN(raw$) THEN symbol$=rec_trim$(raw$(i+1 TO))
788       IF key$="#ENDIF" THEN
789         IF rc_ifn=savedif THEN rec_fail "#ENDIF without #IFDEF in this file"
790         rc_active=rc_if(rc_ifn): rc_ifn=rc_ifn-1: NEXT rec_read_source
791       END IF
792       IF key$="#IFDEF" THEN
793         IF rc_ifn=32 THEN rec_fail "Conditional nesting exceeds 32"
794         rc_ifn=rc_ifn+1: rc_if(rc_ifn)=rc_active
795         IF NOT rec_find(rec_upper$(symbol$),rc_def$,rc_defn) THEN rc_active=0
796         NEXT rec_read_source
797       END IF
798       IF NOT rc_active THEN NEXT rec_read_source
799       IF key$="#DEFINE" THEN
800         IF rc_defn=d_labels THEN rec_fail "Too many #DEFINE symbols"
801         IF LEN(symbol$)>d_length THEN rec_fail "#DEFINE symbol too long"
802         rc_defn=rc_defn+1: rc_def$(rc_defn)=rec_upper$(symbol$): NEXT rec_read_source
803       END IF
804       IF key$="#INCLUDE" THEN rec_select d_working$ & symbol$,channel+1: NEXT rec_read_source
805     END IF
806     IF NOT rc_active THEN NEXT rec_read_source
807     IF NOT rc_enabled THEN rec_discover text$
808     rec_spoolline text$
809   END REPeat rec_read_source
810   IF rc_ifn<>savedif THEN rec_fail "#IFDEF crosses file boundary"
811   CLOSE #channel: file_num=channel-1
812 END DEFine rec_select
