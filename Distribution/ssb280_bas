749 DEFine PROCedure rec_select(source$,channel)
750   LOCal text$(1000),next$(1000),raw$(1000),sourceLine,origin,i,j,key$(64),symbol$(100),savedif
751   IF channel>23 THEN rec_fail "Include depth exceeds reserved input channels 5..23"
752   IF FOP_IN(#channel,source$)<0 THEN rec_fail "Cannot open include/source: " & source$
753   file_num=channel: sourceLine=0: savedif=rc_ifn
754   REPeat rec_read_source
755     IF EOF(#channel) THEN EXIT rec_read_source
756     INPUT #channel,text$: sourceLine=sourceLine+1: origin=sourceLine
757     text$=stripTab$(text$)
758     REPeat rec_join_source
759       IF LEN(text$)<2 THEN EXIT rec_join_source
760       IF text$(LEN(text$)-1 TO)<>"\+" THEN EXIT rec_join_source
761       IF EOF(#channel) THEN rec_fail "Continuation at end of file"
762       INPUT #channel,next$: sourceLine=sourceLine+1
763       text$=text$(TO LEN(text$)-2) & " " & rec_ltrim$(next$)
764       IF LEN(text$)>1000 THEN rec_fail "Joined source sourceLine exceeds 1000 bytes"
765     END REPeat rec_join_source
766     rc_file$=source$: rc_line=origin
767     raw$=rec_trim$(text$)
768     IF raw$="" THEN
769       IF rc_active AND d_ignore$<>"Y" THEN rec_spoolline text$
770       NEXT rec_read_source
771     END IF
772     IF raw$(1)="." THEN NEXT rec_read_source
773     IF raw$(1)="#" AND raw$(1 TO 2)<>"##" THEN
774       i=" " INSTR raw$: IF NOT i THEN i=LEN(raw$)+1
775       key$=rec_upper$(raw$(1 TO i-1)): symbol$=""
776       IF i<LEN(raw$) THEN symbol$=rec_trim$(raw$(i+1 TO))
777       IF key$="#ENDIF" THEN
778         IF rc_ifn=savedif THEN rec_fail "#ENDIF without #IFDEF in this file"
779         rc_active=rc_if(rc_ifn): rc_ifn=rc_ifn-1: NEXT rec_read_source
780       END IF
781       IF key$="#IFDEF" THEN
782         IF rc_ifn=32 THEN rec_fail "Conditional nesting exceeds 32"
783         rc_ifn=rc_ifn+1: rc_if(rc_ifn)=rc_active
784         IF NOT rec_find(rec_upper$(symbol$),rc_def$,rc_defn) THEN rc_active=0
785         NEXT rec_read_source
786       END IF
787       IF NOT rc_active THEN NEXT rec_read_source
788       IF key$="#DEFINE" THEN
789         IF rc_defn=d_labels THEN rec_fail "Too many #DEFINE symbols"
790         IF LEN(symbol$)>d_length THEN rec_fail "#DEFINE symbol too long"
791         rc_defn=rc_defn+1: rc_def$(rc_defn)=rec_upper$(symbol$): NEXT rec_read_source
792       END IF
793       IF key$="#INCLUDE" THEN rec_select d_working$ & symbol$,channel+1: NEXT rec_read_source
794     END IF
795     IF NOT rc_active THEN NEXT rec_read_source
796     IF NOT rc_enabled THEN rec_discover text$
797     rec_spoolline text$
798   END REPeat rec_read_source
799   IF rc_ifn<>savedif THEN rec_fail "#IFDEF crosses file boundary"
800   CLOSE #channel: file_num=channel-1
801 END DEFine rec_select
