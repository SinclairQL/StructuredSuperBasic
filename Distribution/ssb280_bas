1224 DEFine PROCedure pass_two_file (in_file$, file_num)
1225   LOCal in3$(100), a$(100), space$(1), rem$(2)
1226   LOCal comm$(2), at$(1), lab$(1), cont$(2)
1227   rem$ = CHR$(42) & CHR$(42): REMark REMark flag.
1228   comm$ = CHR$(35) & CHR$(35): REMark Comment flag, ignore these lines.
1229   lab$ = CHR$(64): REMark Label flag. 
1230   cont$ = "\+": REMark Continuation flag, join this to the next line(s).
1231   OPEN_IN #file_num,in_file$
1232   REPeat pass_2
1233     num_count = num_count + 1
1234     IF (num_count MOD 10) = 0 THEN PRINT #3,CHR$(1);
1235     IF EOF(#file_num) THEN EXIT pass_2
1236     INPUT #file_num,in$
1237     rec_origin
1238     in$ = stripTab$(in$)  
1239     temp=first_char(in$)
1240     IF temp=0 THEN
1241       IF d_ignore$ == "Y" THEN
1242         NEXT pass_2
1243       ELSE
1244         rec_range
1245         print #4, line_num; " :"           
1246         line_num = line_num + line_delta
1247         next pass_2
1248       END IF
1249     END IF
1250     IF in$(1) = lab$ THEN NEXT pass_2: END IF
1251     IF in$(temp TO temp + 1) = comm$ THEN NEXT pass_2: END IF
1252     IF in$(temp) = "." THEN NEXT pass_2: END IF
1253     IF in$(LEN(in$)-1 TO) = "\+" THEN
1254       REMark Join lines until we have the complete line.
1255       REMark ready for further processing.
1256       in$ = joinLine$(in$)
1257     END IF
1258     IF comm$ INSTR in$ THEN
1259       in$ = stripComment$(in$)
1260     END IF
1261     IF rem$ INSTR in$ THEN
1262       in$ = doRemark$(in$)
1263     END IF
1264     IF upper$(in$(1 TO 7))="#DEFINE" THEN NEXT pass_2: END IF
1265     IF LEN(in$) >= 6 THEN
1266       IF in$(1 TO 6) = "#ENDIF" THEN NEXT pass_2: END IF
1267     END IF
1268     temp = lab$ INSTR in$
1269     IF rc_enabled THEN temp=rec_labelref(in$)
1270     IF temp<>0 THEN
1271       a$ = in$(temp TO )
1272       temp2 = 0
1273       REPEAT loop2
1274         temp2 = temp2 + 1
1275         IF temp2 > d_labels THEN
1276           BEEP 1000,10
1277           INK #3,2
1278           PRINT #3,lngarray$(35);a$;lngarray$(32)
1279           PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
1280           abort_out
1281         END IF
1282         IF label$(temp2) == a$ THEN EXIT loop2
1283       END REPEAT loop2
1284       rec_range
1285       PRINT #4,line_num;" ";in$(1 TO temp-1);label(temp2)
1286       line_num = line_num + line_delta
1287     ELSE
1288       IF upper$(in$(1 to 8))="#INCLUDE" THEN
1289         pass_two_file d_working$&in$(10 to), file_num+1
1290       ELSE
1291         IF upper$(in$(1 TO 6))="#IFDEF" THEN
1292           temp = 0
1293           temp$ = upper$(in$(8 TO))
1294           FOR x = 1 TO define_var
1295             IF temp$ = defn$((x),1 TO LEN(temp$)) THEN temp = x
1296           END FOR X
1297           IF temp = 0 THEN
1298             REPEAT loop
1299               INPUT #file_num,in2$
1300               IF LEN(in2$) < 6 THEN NEXT loop
1301               IF upper$(in2$(1 TO 6))="#ENDIF" THEN EXIT loop
1302             END REPeat loop
1303           END IF
1304         ELSE
1305           rec_range
1306           PRINT #4,line_num;" ";in$
1307           line_num = line_num + line_delta
1308         END IF
1309       END IF
1310     END IF
1311   END REPeat pass_2
1312   CLOSE #file_num
1313 END DEFine pass_two_file
