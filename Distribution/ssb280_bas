840 DEFine PROCedure rec_discover(text$)
841   LOCal i,j,n,depth,previous$(1024),word$(1024),first$(1024),quote$(1024),c$(1024)
842   i=1: n=0: depth=0: previous$="": quote$="": first$=""
843   REPeat rec_discovery
844     IF i>LEN(text$) THEN RETurn
845     c$=text$(i)
846     IF quote$<>"" THEN
847       IF c$=quote$ THEN quote$=""
848       i=i+1: NEXT rec_discovery
849     END IF
850     IF c$='"' OR c$="'" THEN quote$=c$: i=i+1: NEXT rec_discovery
851     IF i<LEN(text$) THEN
852       IF text$(i TO i+1)="##" OR text$(i TO i+1)="**" THEN RETurn
853     END IF
854     IF rec_letter(c$) THEN
855       j=i
856       REPeat rec_discovery_word
857         IF j=LEN(text$) THEN EXIT rec_discovery_word
858         IF NOT rec_namechar(text$(j+1)) THEN EXIT rec_discovery_word
859         j=j+1
860       END REPeat rec_discovery_word
861       word$=rec_upper$(text$(i TO j)): n=n+1
862       IF n=1 THEN
863         first$=word$
864         IF first$="TYPE" THEN rc_enabled=1: RETurn
865         IF first$<>"DIM" AND first$<>"LOCAL" AND first$<>"DEF" AND first$<>"DEFINE" THEN RETurn
866       ELSE
867         IF word$="AS" AND n>2 AND previous$<>"" AND previous$<>"(" AND previous$<>"," THEN
868           IF depth=0 AND (first$="DIM" OR first$="LOCAL") THEN rc_enabled=1: RETurn
869           IF n>3 AND (first$="DEFINE" OR first$="DEF") THEN rc_enabled=1: RETurn
870         END IF
871         IF word$="VAL" AND n>3 AND (first$="DEFINE" OR first$="DEF") THEN rc_enabled=1: RETurn
872       END IF
873       previous$=word$: i=j+1
874     ELSE
875       IF c$="(" THEN depth=depth+1
876       IF c$=")" THEN depth=depth-1
877       IF c$<>" " AND c$<>CHR$(9) THEN previous$=c$
878       i=i+1
879     END IF
880   END REPeat rec_discovery
881 END DEFine rec_discover
