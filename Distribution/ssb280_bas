620 DEFine PROCedure pass_one_file (in_file$, file_num)
621   errorx = FOP_IN(#file_num,in_file$)
622   INK #3,2
623   IF errorx = -12 THEN
624     BEEP 1000,10
625     PRINT #3,lngarray$(21);in_file$
626     abort_out
627   END IF
628   IF errorx = -7 THEN
629     BEEP 1000,10
630     PRINT #3,lngarray$(22);in_file$
631     abort_out
632   END IF
633   IF errorx = -9 THEN
634     BEEP 1000,10
635     PRINT #3,lngarray$(23);in_file$
636     abort_out
637   END IF
638   INK #3,4
639   REPeat pass_1
640     num_count = num_count + 1
641     IF (num_count MOD 10) = 0 THEN PRINT #3,CHR$(1);
642     IF EOF(#file_num) THEN EXIT pass_1
643     INPUT #file_num,in$
644     rec_origin
645     temp=first_char(in$)
646     IF temp=0 THEN NEXT pass_1
647     IF in$(temp TO temp+1)=CHR$(35)&CHR$(35) THEN NEXT pass_1
648     IF in$(temp)="." THEN NEXT pass_1
649     IF LEN(in$) >= 6 THEN
650       IF in$(1 TO 6) = "#ENDIF" THEN NEXT pass_1
651     END IF
652     REPeat loop
653       IF in$(LEN(in$)-1 TO)="\+" THEN
654         IF EOF(#file_num) THEN
655           BEEP 1000,10
656           INK #3,2
657           PRINT #3,lngarray$(24)
658           PRINT #3,lngarray$(25);in_file$
659           abort_out
660         END IF
661         INPUT #file_num,in2$
662         temp = first_char(in2$)
663         in$ = in$( TO LEN(in$)-2) & " " & in2$(temp TO)
664       ELSE
665         EXIT loop
666       END IF
667     END REPeat loop
668     IF in$(1)=CHR$(64) THEN
669       IF LEN(in$) > d_length+1 THEN
670         BEEP 1000,10
671         INK #3,2
672         PRINT #3,lngarray$(26);in$;lngarray$(27)
673         PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
674         abort_out
675       END IF
676       IF label_var = d_labels THEN
677         BEEP 1000,10
678         INK #3,2
679         PRINT #3,lngarray$(30)
680         PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
681         abort_out
682       END IF
683       label$(label_var) = in$
684       label(label_var) = line_num
685       label_var = label_var + 1
686     ELSE
687       IF upper$(in$(1 TO 8))="#INCLUDE" THEN
688         pass_one_file d_working$&in$(10 to ), file_num+1
689       ELSE
690         IF upper$(in$(1 TO 7))="#DEFINE" THEN
691           IF LEN(in$(9 TO)) > d_length THEN
692             BEEP 1000,10
693             INK #3,2
694             PRINT #3,lngarray$(31);in$(9 TO);lngarray$(27)
695             PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
696             abort_out
697           END IF
698           IF define_var = d_labels THEN
699             BEEP 1000,10
700             INK #3,2
701             PRINT #3,lngarray$(33)
702             PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
703             abort_out
704           END IF
705           defn$(define_var) = upper$(in$( 9 TO))
706           define_var = define_var+1
707         ELSE
708           IF upper$(in$(1 TO 6))="#IFDEF" THEN
709             temp = 0
710             temp$ = upper$(in$(8 TO))
711             FOR x = 1 TO define_var
712               IF temp$ = defn$(x) THEN temp = 1
713             END FOR X
714             IF temp = 0 THEN
715               REPEAT loop
716                 IF EOF(#file_num) THEN
717                   BEEP 1000,10
718                   INK #3,2
719                   PRINT #3,lngarray$(34)
720                   PRINT #3,lngarray$(25);in_file$
721                   abort_out
722                 END IF
723                 INPUT #file_num,in2$
724                 IF LEN(in2$) < 6 THEN NEXT loop
725                 IF upper$(in2$(1 TO 6))="#ENDIF" THEN EXIT loop
726               END REPeat loop
727             END IF
728           ELSE
729             rec_range
730             line_num = line_num + line_delta
731           END IF
732         END IF
733       END IF
734     END IF
735   END REPeat pass_1
736   CLOSE #file_num
737 END DEFine pass_one_file
