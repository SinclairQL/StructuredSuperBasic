1539 DEFine FuNction rec_expr$(text$)
1540   LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
1541   LOCal i,j,v,pos,result$(1024),s$(1024),before
1542   LOCal vw_var,vw_type,vw_rank,vw_end,vw_leaf,vw_sel$(1024),vw_prefix$(160)
1543   rec_lex text$: i=1: pos=1: result$=""
