2089 DEFine PROCedure rec_lex(text$)
2090   LOCal i,j,c$(160),q$(1),depth
2091   rk_line$=text$: rk_n=0: i=1
2092   REPeat rec_scan
2093     IF i>LEN(text$) THEN EXIT rec_scan
2094     c$=text$(i)
2095     IF c$=" " OR c$=CHR$(9) THEN i=i+1: NEXT rec_scan
2096     IF rk_n=256 THEN rec_fail "Too many tokens on one line"
2097     rk_n=rk_n+1: rk_s(rk_n)=i: rk_kind(rk_n)=4
2098     j=i
2099     IF c$='"' OR c$="'" THEN
2100       rk_kind(rk_n)=3: q$=c$: j=i+1
2101       REPeat rec_quote
2102         IF j>LEN(text$) THEN rec_fail "Unterminated quoted string"
2103         IF text$(j)=q$ THEN EXIT rec_quote
2104         j=j+1
2105       END REPeat rec_quote
2106     ELSE
2107       IF rec_letter(c$) THEN
2108         rk_kind(rk_n)=1
2109         REPeat rec_ident
2110           IF j=LEN(text$) THEN EXIT rec_ident
2111           IF NOT rec_namechar(text$(j+1)) THEN EXIT rec_ident
2112           j=j+1
2113         END REPeat rec_ident
2114         IF j<LEN(text$) THEN
2115           IF text$(j+1)="$" OR text$(j+1)="%" THEN j=j+1
2116         END IF
2117       ELSE
2118         IF rec_digit(c$) OR c$="$" OR c$="%" THEN
2119           rk_kind(rk_n)=2
2120           REPeat rec_number
2121             IF j=LEN(text$) THEN EXIT rec_number
2122             c$=rec_upper$(text$(j+1))
2123             IF NOT rec_namechar(c$) AND c$<>"." THEN EXIT rec_number
2124             j=j+1
2125             IF c$="E" AND j<LEN(text$) THEN
2126               IF text$(j+1)="+" OR text$(j+1)="-" THEN j=j+1
2127             END IF
2128           END REPeat rec_number
2129         END IF
2130       END IF
2131     END IF
2132     rk_e(rk_n)=j
2133     IF rk_kind(rk_n)=3 THEN
2134       rk_len%(rk_n)=1
2135     ELSE
2136       IF j-i>159 THEN rec_fail "Identifier/number token exceeds 160 bytes"
2137       rk_len%(rk_n)=j-i+1
2138     END IF
2139     c$=rec_upper$(rec_token$(rk_n))
2140     IF c$="REMARK" OR c$="REM" OR c$="DATA" THEN
2141       rk_e(rk_n)=LEN(text$): rk_len%(rk_n)=LEN(c$): rk_kind(rk_n)=5
2142       EXIT rec_scan
2143     END IF
2144     IF j<LEN(text$) THEN
2145       c$=text$(j TO j+1)
2146       IF c$="##" OR c$="**" THEN
2147         rk_e(rk_n)=LEN(text$): rk_len%(rk_n)=LEN(c$): rk_kind(rk_n)=5
2148         EXIT rec_scan
2149       END IF
2150     END IF
2151     i=j+1
2152   END REPeat rec_scan
2153 END DEFine rec_lex
2154 DEFine FuNction rec_token$(tokenIndex)
2155   LOCal first,last
2156   IF tokenIndex<1 OR tokenIndex>rk_n THEN RETurn ""
2157   first=rk_s(tokenIndex): last=first+rk_len%(tokenIndex)-1
2158   IF rk_kind(tokenIndex)=5 THEN RETurn rec_upper$(rk_line$(first TO last))
2159   RETurn rk_line$(first TO last)
