1545     IF i>rk_n THEN EXIT rec_expression
1546     IF rk_kind(i)=5 THEN EXIT rec_expression
1547     s$="": j=i
1548     IF rec_token$(i)="." THEN
1549       IF i=rk_n THEN rec_fail "Field selection from a function result is unsupported"
