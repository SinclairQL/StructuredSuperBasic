1093   IF kind$="END" AND (rec_upper$(rec_token$(2))="DEFINE" OR rec_upper$(rec_token$(2))="DEF") THEN
1094     rc_routine=0: RETurn
1095   END IF
1096   IF kind$="MANIFEST" THEN
1097     i=2: IF rec_token$(i)=":" THEN i=i+1
