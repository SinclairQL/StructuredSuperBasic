851 DEFine PROCedure rec_discover(text$)
852   LOCal i,j,n,depth,previous$(1024),word$(1024),first$(1024),quote$(1024),c$(1024)
853   i=1: n=0: depth=0: previous$="": quote$="": first$=""
854   REPeat rec_discovery
855     IF i>LEN(text$) THEN RETurn
856     c$=text$(i)
857     IF quote$<>"" THEN
858       IF c$=quote$ THEN quote$=""
859       i=i+1: NEXT rec_discovery
860     END IF
861     IF c$='"' OR c$="'" THEN quote$=c$: i=i+1: NEXT rec_discovery
862     IF i<LEN(text$) THEN
863       IF text$(i TO i+1)="##" OR text$(i TO i+1)="**" THEN RETurn
864     END IF
865     IF rec_letter(c$) THEN
866       j=i
867       REPeat rec_discovery_word
868         IF j=LEN(text$) THEN EXIT rec_discovery_word
869         IF NOT rec_namechar(text$(j+1)) THEN EXIT rec_discovery_word
870         j=j+1
871       END REPeat rec_discovery_word
872       word$=rec_upper$(text$(i TO j)): n=n+1
873       IF n=1 THEN
874         first$=word$
875         IF first$="TYPE" THEN rc_enabled=1: RETurn
876         IF first$<>"DIM" AND first$<>"LOCAL" AND first$<>"DEF" AND first$<>"DEFINE" THEN RETurn
877       ELSE
878         IF word$="AS" AND n>2 AND previous$<>"" AND previous$<>"(" AND previous$<>"," THEN
879           IF depth=0 AND (first$="DIM" OR first$="LOCAL") THEN rc_enabled=1: RETurn
880           IF n>3 AND (first$="DEFINE" OR first$="DEF") THEN rc_enabled=1: RETurn
881         END IF
882         IF word$="VAL" AND n>3 AND (first$="DEFINE" OR first$="DEF") THEN rc_enabled=1: RETurn
883       END IF
884       previous$=word$: i=j+1
885     ELSE
886       IF c$="(" THEN depth=depth+1
887       IF c$=")" THEN depth=depth-1
888       IF c$<>" " AND c$<>CHR$(9) THEN previous$=c$
889       i=i+1
890     END IF
891   END REPeat rec_discovery
892 END DEFine rec_discover
