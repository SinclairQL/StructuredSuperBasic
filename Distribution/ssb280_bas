961   IF a=b AND rk_kind(a)=2 AND isnum(s$) THEN
962     v=s$
963   ELSE
964     i=rec_find(s$,rm_name$,rm_n)
965     IF NOT i THEN rec_fail "Field bound needs an integer literal or numeric MANIFEST: " & s$
966     v=rm_value(i)
967   END IF
968   IF v<0 OR v>32767 OR v<>INT(v) OR (stringcap AND v=0) THEN rec_fail "Invalid fixed field bound: " & s$
969   RETurn rec_num$(v)
970 END DEFine rec_bound$
971 DEFine PROCedure rec_descriptor(a,b,formal)
972   LOCal i,j,last,rs_b(64),rs_e(64),rs_n,asat
973   rd_name$=rec_token$(a): rd_shape$="": rd_rank=0: rd_type=0: rd_val=0: rd_pool=0
974   IF rec_upper$(rd_name$)="VAL" THEN
975     rd_val=1: a=a+1: rd_name$=rec_token$(a)
976   END IF
977   IF rk_kind(a)<>1 THEN rec_fail "Expected a declared name"
978   IF LEN(rd_name$)>64 THEN rec_fail "Declared names are limited to 64 bytes"
979   i=a+1
980   IF i<=b THEN
981     IF rec_token$(i)="(" THEN
982       j=rec_match(i,b): rd_shape$=rec_part$(i+1,j-1)
983       IF formal THEN
984         FOR last=i+1 TO j-1
985           IF rec_token$(last)<>"," THEN rec_fail "Record array formals use empty dimensions"
986         END FOR last
987         rd_rank=1
988         FOR last=i+1 TO j-1
989           rd_rank=rd_rank+1
990         END FOR last
991       ELSE
992         rec_split i+1,j-1: rd_rank=rs_n
993         IF NOT rs_n THEN rec_fail "Record storage arrays need dimension bounds"
994       END IF
995       i=j+1
996     END IF
997   END IF
998   IF i<=b THEN
999     IF rec_upper$(rec_token$(i))<>"AS" OR i+1>b THEN rec_fail "Expected AS recordType"
1000     rd_type=rec_typeid(rec_token$(i+1)): i=i+2
1001   END IF
1002   IF i<=b THEN
1003     IF rec_upper$(rec_token$(i))<>"POOL" OR i<>b THEN rec_fail "Unexpected text after record declaration"
1004     rd_pool=1: i=i+1
1005   END IF
1006   IF rd_val AND (rd_type OR rd_rank) THEN rec_fail "VAL supports scalar numbers and strings only"
1007   IF rd_pool AND (formal OR NOT rd_type OR rd_rank<>1) THEN rec_fail "POOL requires a global one-dimensional record array"
1008 END DEFine rec_descriptor
1009 DEFine PROCedure rec_collect(text$)
1010   LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
1011   LOCal rs_b(64),rs_e(64),rs_n,i,j,k,a,b,kind$(1024),name$(1024),n,v
1012   LOCal rd_name$(64),rd_shape$(1024),rd_rank,rd_type,rd_val,rd_pool
1013   rec_lex text$
1014   IF rk_n=0 THEN RETurn
1015   kind$=rec_upper$(rec_token$(1))
1016   IF rk_kind(1)=5 OR kind$=CHR$(64) THEN RETurn
1017   b=rk_n: IF rk_kind(b)=5 THEN b=b-1
1018   IF kind$="TYPE" THEN
1019     IF rc_type OR rc_routine OR b<>2 THEN rec_fail "TYPE must be a top-level declaration"
1020     rc_type=rec_typeid(rec_token$(2))
1021     IF rt_defined(rc_type) THEN rec_fail "Duplicate TYPE: " & rec_token$(2)
1022     rt_defined(rc_type)=1: RETurn
1023   END IF
1024   IF kind$="END" AND rec_upper$(rec_token$(2))="TYPE" THEN
1025     IF NOT rc_type THEN rec_fail "END TYPE without TYPE"
1026     rc_type=0: RETurn
1027   END IF
1028   IF kind$="REFERENCE" AND NOT rc_type THEN
1029     RETurn
1030   END IF
1031   IF rc_type THEN
1032     rec_descriptor 1,b,0
1033     IF rd_val OR rd_pool THEN rec_fail "Invalid TYPE field"
1034     FOR i=1 TO rf_n
1035       IF rf_owner(i)=rc_type AND rec_upper$(rf_name$(i))=rec_upper$(rd_name$) THEN rec_fail "Duplicate field: " & rd_name$
1036     END FOR i
1037     rec_room rf_n,rc_cap,"Field"
1038     rf_n=rf_n+1: rf_owner(rf_n)=rc_type: rf_name$(rf_n)=rec_upper$(rd_name$): rf_type(rf_n)=rd_type
1039     IF rd_type THEN
1040       IF rd_rank THEN rec_fail "Arrays of embedded records are not supported"
1041     ELSE
1042       IF rd_name$(LEN(rd_name$))="$" AND NOT rd_rank THEN rec_fail "String fields require a capacity"
1043       IF rd_rank THEN
1044         rec_split 3,b-1: rd_shape$=""
1045         FOR i=1 TO rs_n
1046           v=rd_name$(LEN(rd_name$))="$" AND i=rs_n
1047           rd_shape$=rec_join$(rd_shape$,rec_bound$(rs_b(i),rs_e(i),v))
1048         END FOR i
1049       END IF
1050       rf_shape$(rf_n)=rd_shape$: rf_rank(rf_n)=rd_rank
1051       IF rd_name$(LEN(rd_name$))="$" THEN rf_rank(rf_n)=rd_rank-1
1052     END IF
1053     RETurn
1054   END IF
1055   IF kind$="DEFINE" OR kind$="DEF" THEN
1056     IF rc_routine THEN rec_fail "Nested routines are not supported by the record profile"
1057     name$=rec_token$(3)
1058     rec_user name$,0
1059     IF rec_find(name$,rr_name$,rr_n) THEN rec_fail "Duplicate routine: " & name$
1060     rec_room rr_n,rc_cap,"Routine"
1061     rr_n=rr_n+1: rc_routine=rr_n: rr_name$(rr_n)=rec_upper$(name$): rr_first(rr_n)=ra_n+1
1062     rr_fun(rr_n)=rec_upper$(rec_token$(2))="FUNCTION" OR rec_upper$(rec_token$(2))="FUN"
1063     IF b>3 THEN
1064       IF rec_token$(4)<>"(" THEN rec_fail "Routine result annotations are not supported; use an output record parameter"
1065       j=rec_match(4,b)
1066       IF j<>b THEN rec_fail "Functions cannot return records; use an output record parameter"
1067       rec_split 5,j-1
1068       FOR i=1 TO rs_n
1069         rec_descriptor rs_b(i),rs_e(i),1
1070         rec_room ra_n,rc_cap,"Parameter"
1071         ra_n=ra_n+1: ra_name$(ra_n)=rec_upper$(rd_name$): ra_val(ra_n)=rd_val: ra_rank(ra_n)=rd_rank
1072         IF rd_type THEN
1073           ra_var(ra_n)=rec_variable(rd_name$,rd_type,rd_rank)
1074         ELSE
1075           rec_user rd_name$,1
1076         END IF
1077         rr_count(rr_n)=rr_count(rr_n)+1
1078       END FOR i
1079     END IF
1080     RETurn
1081   END IF
1082   IF kind$="END" AND (rec_upper$(rec_token$(2))="DEFINE" OR rec_upper$(rec_token$(2))="DEF") THEN
1083     rc_routine=0: RETurn
1084   END IF
1085   IF kind$="MANIFEST" THEN
1086     i=2: IF rec_token$(i)=":" THEN i=i+1
1087     IF b=i+2 AND rec_token$(i+1)="=" AND isnum(rec_token$(i+2)) THEN
1088       v=rec_find(rec_token$(i),rm_name$,rm_n)
1089       IF NOT v THEN
1090         rec_room rm_n,rc_cap,"Manifest"
1091         rm_n=rm_n+1: v=rm_n
1092       END IF
1093       rm_name$(v)=rec_upper$(rec_token$(i)): rm_value(v)=rec_token$(i+2)
1094     END IF
1095   END IF
1096   IF kind$="FOR" AND b>3 THEN
1097     IF rec_token$(3)="=" THEN rec_user rec_token$(2),1
1098   END IF
1099   IF kind$="IMPLICIT%" OR kind$="IMPLICIT$" THEN
1100     FOR i=2 TO b
1101       IF rk_kind(i)=1 THEN
1102         rec_user rec_token$(i),1
1103       ELSE
1104         IF rec_token$(i)<>"," THEN rec_fail "Use an explicit IMPLICIT name list"
1105       END IF
1106     END FOR i
1107     RETurn
1108   END IF
1109   IF kind$="DIM" OR kind$="LOCAL" THEN
1110     rec_split 2,b
1111     FOR i=1 TO rs_n
1112       a=rs_b(i): n=0
1113       FOR j=a TO rs_e(i)
1114         IF rec_upper$(rec_token$(j))="AS" THEN n=1
1115       END FOR j
1116       IF n THEN
1117         rec_descriptor a,rs_e(i),0
1118         IF kind$="LOCAL" AND NOT rc_routine THEN rec_fail "LOCal record outside a routine"
1119         v=rec_variable(rd_name$,rd_type,rd_rank)
1120         IF kind$="LOCAL" THEN
1121           n=0
1122           FOR k=1 TO rc_locals
1123             IF rc_lr(k)=rc_routine AND rc_lv(k)=v THEN n=1
1124           END FOR k
1125           IF NOT n THEN
1126           rec_room rc_locals,rc_cap,"Local record"
1127           rc_locals=rc_locals+1: rc_lr(rc_locals)=rc_routine: rc_lv(rc_locals)=v
1128           END IF
1129         END IF
1130         IF rd_pool THEN
1131           IF kind$<>"DIM" OR rc_routine THEN rec_fail "POOL must be global"
1132           rv_pool(v)=1
1133         END IF
1134       ELSE
1135         rec_user rec_token$(a),1
1136         IF kind$="LOCAL" AND rc_routine THEN rr_simplelocals(rc_routine)=rr_simplelocals(rc_routine)+1
1137         IF a<rs_e(i) THEN
1138           IF rec_token$(a+1)="(" THEN rn_array(rec_find(rec_token$(a),rn_name$,rn_n))=1
1139         END IF
1140       END IF
1141     END FOR i
1142   END IF
1143   FOR i=1 TO b
1144     IF rk_kind(i)=1 THEN
1145       n=1
1146       IF i>1 THEN
1147         IF rec_token$(i-1)="." OR rec_upper$(rec_token$(i-1))="AS" THEN n=0
1148       END IF
1149       IF n THEN rec_user rec_token$(i),0
1150     END IF
1151   END FOR i
1152   IF b>1 AND rk_kind(1)=1 AND rec_token$(2)="=" THEN rn_assignment(rec_find(rec_token$(1),rn_name$,rn_n))=1
1153 END DEFine rec_collect
