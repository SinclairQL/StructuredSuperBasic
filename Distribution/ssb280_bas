1732 DEFine PROCedure rec_statement(text$)
1733   LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
1734   LOCal rs_b(64),rs_e(64),rs_n,i,j,k,b,depth,cut,thenat,elseat,endat,kind$(64),s$(1024),v,before
1735   LOCal rd_name$(64),rd_shape$(1024),rd_rank,rd_type,rd_val,rd_pool
1736   LOCal vw_var,vw_type,vw_rank,vw_end,vw_leaf,vw_sel$(1024),vw_prefix$(160)
1737   LOCal remaining$(1000)
1738   remaining$=text$
1739   rec_lex remaining$
1740   IF rk_n=0 THEN
1741     IF d_ignore$<>"Y" THEN rec_put ":"
1742     RETurn
1743   END IF
1744   kind$=rec_upper$(rec_token$(1)): b=rk_n
1745   IF kind$=CHR$(64) THEN rec_put remaining$: RETurn
1746   IF kind$="TYPE" THEN rc_type=1: RETurn
1747   IF kind$="END" AND rec_upper$(rec_token$(2))="TYPE" THEN rc_type=0: RETurn
1748   IF rc_type THEN RETurn
1749   IF rk_kind(1)=5 THEN
1750     IF kind$="DATA" THEN rec_data remaining$
1751     rec_put remaining$: RETurn
1752   END IF
1753   IF rk_kind(b)=5 THEN b=b-1
1754   IF b=0 THEN rec_put remaining$: RETurn
1755   IF kind$="DEFINE" OR kind$="DEF" THEN
1756     rc_routine=rec_find(rec_token$(3),rr_name$,rr_n): rec_header rc_routine: RETurn
1757   END IF
1758   IF kind$="END" AND (rec_upper$(rec_token$(2))="DEFINE" OR rec_upper$(rec_token$(2))="DEF") THEN
1759     rec_put remaining$: rc_routine=0: RETurn
1760   END IF
1761   IF kind$="REFERENCE" THEN RETurn
1762   IF kind$="IF" THEN
1763     depth=0: thenat=0: elseat=0: endat=0
1764     FOR i=2 TO b
1765       IF rec_token$(i)="(" THEN depth=depth+1
1766       IF rec_token$(i)=")" THEN depth=depth-1
1767       IF depth=0 THEN
1768         IF rec_upper$(rec_token$(i))="THEN" AND NOT thenat THEN thenat=i
1769         IF thenat AND rec_upper$(rec_token$(i))="IF" THEN
1770           IF rec_upper$(rec_token$(i-1))<>"END" THEN rec_fail "Use multiline form for nested inline IF"
1771         END IF
1772         IF rec_upper$(rec_token$(i))="ELSE" THEN
1773           IF elseat THEN rec_fail "Use multiline form for nested inline IF"
1774           elseat=i
1775         END IF
1776         IF rec_upper$(rec_token$(i))="END" AND i<b THEN
1777           IF rec_upper$(rec_token$(i+1))="IF" THEN endat=i
1778         END IF
1779       END IF
1780     END FOR i
1781     IF NOT thenat THEN rec_fail "Record profile requires THEN in IF statements"
1782     IF thenat=b-1 AND rec_token$(b)=":" THEN rec_fail "Put THEN last on a multiline IF header"
1783     rec_put "IF " & rec_expr$(rec_part$(2,thenat-1)) & " THEN"
1784     IF thenat=b THEN RETurn
1785     j=b: IF endat THEN j=endat-1
1786     IF elseat THEN
1787       rec_statement rec_part$(thenat+1,elseat-1): rec_put "ELSE"
1788       rec_statement rec_part$(elseat+1,j)
1789     ELSE
1790       rec_statement rec_part$(thenat+1,j)
1791     END IF
1792     rec_put "END IF": RETurn
1793   END IF
1794   depth=0: cut=0
1795   FOR i=1 TO b
1796     IF rec_token$(i)="(" THEN depth=depth+1
1797     IF rec_token$(i)=")" THEN depth=depth-1
1798     IF rec_token$(i)=":" AND depth=0 THEN cut=i: EXIT i
1799   END FOR i
1800   IF cut THEN
1801     IF kind$="=" THEN
1802       before=rc_temp: s$=rec_expr$(rec_part$(1,cut-1))
1803       IF rc_temp<>before THEN rec_fail "Split record argument captures out of SELECT case values"
1804       rec_put s$ & ":": remaining$=rec_part$(cut+1,rk_n): GO TO 1739
1805     END IF
1806     IF kind$="FOR" OR kind$="REPEAT" OR kind$="REP" THEN
1807       FOR j=cut+1 TO b-1
1808         IF rec_upper$(rec_token$(j))="END" THEN
1809           IF rec_upper$(rec_token$(j+1))=kind$ THEN rec_fail "Use multiline form for explicitly closed inline loops"
1810         END IF
1811       END FOR j
1812       s$=rec_token$(2)
1813       IF kind$="FOR" THEN
1814         j=3
1815         REPeat rec_counter_end
1816           IF j>=cut THEN rec_fail "FOR counter requires an assignment"
1817           IF rec_token$(j)="=" THEN EXIT rec_counter_end
1818           j=j+1
1819         END REPeat rec_counter_end
1820         s$=rec_part$(2,j-1)
1821       END IF
1822       rec_statement rec_part$(1,cut-1)
1823       rec_statement rec_part$(cut+1,rk_n)
1824       rec_put "END " & rec_token$(1) & " " & rec_expr$(s$): RETurn
1825     END IF
1826     IF cut>1 THEN rec_statement rec_part$(1,cut-1)
1827     IF cut<rk_n THEN remaining$=rec_part$(cut+1,rk_n): GO TO 1739
1828     RETurn
1829   END IF
1830   IF kind$="DIM" OR kind$="LOCAL" THEN
1831     rec_split 2,b
1832     FOR i=1 TO rs_n
1833       k=0
1834       FOR j=rs_b(i) TO rs_e(i)
1835         IF rec_upper$(rec_token$(j))="AS" THEN k=1
1836       END FOR j
1837       IF k THEN
1838         rec_descriptor rs_b(i),rs_e(i),0
1839         v=rec_find(rd_name$,rv_name$,rv_n)
1840         rec_storage v,rd_shape$,rd_pool
1841       ELSE
1842         s$=rec_part$(rs_b(i),rs_e(i))
1843         IF rec_find(rec_token$(rs_b(i)),rv_name$,rv_n) THEN rec_fail "Cannot independently dimension record storage"
1844         rec_put rec_token$(1) & " " & rec_expr$(s$)
1845       END IF
1846     END FOR i
1847     RETurn
1848   END IF
1849   rec_view 1,b
1850   IF vw_var AND NOT vw_leaf THEN
1851     i=vw_end+1
1852     IF i>b OR rec_token$(i)<>"=" THEN rec_fail "Whole record requires an assignment or typed parameter"
1853     rec_copy rec_part$(1,vw_end),rec_part$(i+1,b): RETurn
1854   END IF
1855   v=rec_find(rec_token$(1),rr_name$,rr_n)
1856   IF v AND NOT rr_fun(v) THEN
1857     i=2: j=b
1858     IF i<=b AND rec_token$(i)="(" THEN
1859       k=rec_match(i,b)
1860       IF k=b AND rr_count(v)<>1 THEN j=k-1: i=i+1
1861     END IF
1862     s$=rec_arguments$(v,rec_part$(i,j),0)
1863     IF s$<>"" THEN s$=" " & s$
1864     rec_put rec_token$(1) & s$: RETurn
1865   END IF
1866   IF kind$="FOR" THEN
1867     rec_view 2,b
1868     IF vw_var AND (NOT vw_leaf OR vw_sel$<>"") THEN rec_fail "FOR counter must be a simple scalar field"
1869     IF vw_leaf THEN
1870       IF rl_rank(vw_leaf)<>0 OR rec_isstring(rl_path$(vw_leaf)) THEN rec_fail "FOR counter must be a numeric scalar field"
1871     END IF
1872   END IF
1873   IF kind$="PRINT" OR kind$="RETURN" OR kind$="RET" THEN
1874     before=rc_temp: s$=rec_expr$(rec_part$(2,rk_n))
1875     rec_put rec_token$(1) & " " & s$: RETurn
1876   END IF
1877   IF b>2 AND rk_kind(1)=1 AND rec_token$(2)="=" THEN
1878     rec_put rec_token$(1) & " = " & rec_expr$(rec_part$(3,rk_n)): RETurn
1879   END IF
1880   rec_put rec_expr$(remaining$)
1881 END DEFine rec_statement
1882 DEFine PROCedure rec_data(text$)
