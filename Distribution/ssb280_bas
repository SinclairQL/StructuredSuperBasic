631   END IF
632   IF errorx = -7 THEN
633     BEEP 1000,10
634     PRINT #3,lngarray$(22);in_file$
635     abort_out
636   END IF
637   IF errorx = -9 THEN
638     BEEP 1000,10
639     PRINT #3,lngarray$(23);in_file$
640     abort_out
641   END IF
642   INK #3,4
643   REPeat pass_1
644     num_count = num_count + 1
645     IF (num_count MOD 10) = 0 THEN PRINT #3,CHR$(1);
646     IF EOF(#file_num) THEN EXIT pass_1
647     INPUT #file_num,in$
648     rec_origin
649     in$=stripTab$(in$)
650     temp=first_char(in$)
651     IF temp=0 THEN
652       IF d_ignore$ == "Y" THEN NEXT pass_1
653       rec_range
654       line_num=line_num+line_delta
655       NEXT pass_1
656     END IF
657     IF in$(temp TO temp+1)=CHR$(35)&CHR$(35) THEN NEXT pass_1
658     IF in$(temp)="." THEN NEXT pass_1
659     IF LEN(in$) >= 6 THEN
660       IF in$(1 TO 6) = "#ENDIF" THEN NEXT pass_1
661     END IF
662     REPeat loop
663       IF LEN(in$)<2 THEN EXIT loop
664       IF in$(LEN(in$)-1 TO)="\+" THEN
665         IF EOF(#file_num) THEN
666           BEEP 1000,10
667           INK #3,2
668           PRINT #3,lngarray$(24)
669           PRINT #3,lngarray$(25);in_file$
670           abort_out
671         END IF
672         INPUT #file_num,in2$
673         temp = first_char(in2$)
674         in$ = in$( TO LEN(in$)-2) & " " & in2$(temp TO)
675       ELSE
676         EXIT loop
677       END IF
678     END REPeat loop
679     IF in$(1)=CHR$(64) THEN
680       IF LEN(in$) > d_length+1 THEN
681         BEEP 1000,10
682         INK #3,2
683         PRINT #3,lngarray$(26);in$;lngarray$(27)
684         PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
685         abort_out
686       END IF
687       IF label_var = d_labels THEN
688         BEEP 1000,10
689         INK #3,2
690         PRINT #3,lngarray$(30)
691         PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
692         abort_out
693       END IF
694       label$(label_var) = in$
695       label(label_var) = line_num
696       label_var = label_var + 1
697     ELSE
698       IF upper$(in$(1 TO 8))="#INCLUDE" THEN
699         pass_one_file d_working$&in$(10 to ), file_num+1
700       ELSE
701         IF upper$(in$(1 TO 7))="#DEFINE" THEN
702           IF LEN(in$(9 TO)) > d_length THEN
703             BEEP 1000,10
704             INK #3,2
705             PRINT #3,lngarray$(31);in$(9 TO);lngarray$(27)
706             PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
707             abort_out
708           END IF
709           IF define_var = d_labels THEN
710             BEEP 1000,10
711             INK #3,2
712             PRINT #3,lngarray$(33)
713             PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
714             abort_out
715           END IF
716           defn$(define_var) = upper$(in$( 9 TO))
717           define_var = define_var+1
718         ELSE
719           IF upper$(in$(1 TO 6))="#IFDEF" THEN
720             temp = 0
721             temp$ = upper$(in$(8 TO))
722             FOR x = 1 TO define_var
723               IF temp$ = defn$(x) THEN temp = 1
724             END FOR X
725             IF temp = 0 THEN
726               REPEAT loop
727                 IF EOF(#file_num) THEN
728                   BEEP 1000,10
729                   INK #3,2
730                   PRINT #3,lngarray$(34)
731                   PRINT #3,lngarray$(25);in_file$
732                   abort_out
733                 END IF
734                 INPUT #file_num,in2$
735                 IF LEN(in2$) < 6 THEN NEXT loop
736                 IF upper$(in2$(1 TO 6))="#ENDIF" THEN EXIT loop
737               END REPeat loop
738             END IF
739           ELSE
740             rec_range
741             line_num = line_num + line_delta
742           END IF
743         END IF
744       END IF
745     END IF
746   END REPeat pass_1
747   CLOSE #file_num
748 END DEFine pass_one_file
