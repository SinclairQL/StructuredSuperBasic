624 DEFine PROCedure pass_one_file (in_file$, file_num)
625   errorx = FOP_IN(#file_num,in_file$)
626   INK #3,2
627   IF errorx = -12 THEN
628     BEEP 1000,10
629     PRINT #3,lngarray$(21);in_file$
