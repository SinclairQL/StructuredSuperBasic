1235 DEFine PROCedure pass_two_file (in_file$, file_num)
1236   LOCal in3$(100), a$(100), space$(1), rem$(2)
1237   LOCal comm$(2), at$(1), lab$(1), cont$(2)
1238   rem$ = CHR$(42) & CHR$(42): REMark REMark flag.
1239   comm$ = CHR$(35) & CHR$(35): REMark Comment flag, ignore these lines.
1240   lab$ = CHR$(64): REMark Label flag. 
1241   cont$ = "\+": REMark Continuation flag, join this to the next line(s).
1242   OPEN_IN #file_num,in_file$
1243   REPeat pass_2
1244     num_count = num_count + 1
1245     IF (num_count MOD 10) = 0 THEN PRINT #3,CHR$(1);
1246     IF EOF(#file_num) THEN EXIT pass_2
1247     INPUT #file_num,in$
1248     rec_origin
1249     in$ = stripTab$(in$)  
1250     temp=first_char(in$)
1251     IF temp=0 THEN
1252       IF d_ignore$ == "Y" THEN
1253         NEXT pass_2
1254       ELSE
1255         rec_range
1256         print #4, line_num; " :"           
1257         line_num = line_num + line_delta
1258         next pass_2
1259       END IF
1260     END IF
1261     IF in$(1) = lab$ THEN NEXT pass_2: END IF
1262     IF in$(temp TO temp + 1) = comm$ THEN NEXT pass_2: END IF
1263     IF in$(temp) = "." THEN NEXT pass_2: END IF
1264     IF LEN(in$)>=2 THEN
1265       IF in$(LEN(in$)-1 TO) = "\+" THEN
1266         REMark Join lines until we have the complete line.
1267         REMark ready for further processing.
1268         in$ = joinLine$(in$)
1269       END IF
1270     END IF
1271     IF comm$ INSTR in$ THEN
1272       in$ = stripComment$(in$)
1273     END IF
1274     IF rem$ INSTR in$ THEN
1275       in$ = doRemark$(in$)
1276     END IF
1277     IF upper$(in$(1 TO 7))="#DEFINE" THEN NEXT pass_2: END IF
1278     IF LEN(in$) >= 6 THEN
1279       IF in$(1 TO 6) = "#ENDIF" THEN NEXT pass_2: END IF
1280     END IF
1281     temp = lab$ INSTR in$
1282     IF rc_enabled THEN temp=rec_labelref(in$)
1283     IF temp<>0 THEN
1284       a$ = in$(temp TO )
1285       temp2 = 0
1286       REPEAT loop2
1287         temp2 = temp2 + 1
1288         IF temp2 > d_labels THEN
1289           BEEP 1000,10
1290           INK #3,2
1291           PRINT #3,lngarray$(35);a$;lngarray$(32)
1292           PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
1293           abort_out
1294         END IF
1295         IF label$(temp2) == a$ THEN EXIT loop2
1296       END REPEAT loop2
1297       rec_range
1298       PRINT #4,line_num;" ";in$(1 TO temp-1);label(temp2)
1299       line_num = line_num + line_delta
1300     ELSE
1301       IF upper$(in$(1 to 8))="#INCLUDE" THEN
1302         pass_two_file d_working$&in$(10 to), file_num+1
1303       ELSE
1304         IF upper$(in$(1 TO 6))="#IFDEF" THEN
1305           temp = 0
1306           temp$ = upper$(in$(8 TO))
1307           FOR x = 1 TO define_var
1308             IF temp$ = defn$((x),1 TO LEN(temp$)) THEN temp = x
1309           END FOR X
1310           IF temp = 0 THEN
1311             REPEAT loop
1312               INPUT #file_num,in2$
1313               IF LEN(in2$) < 6 THEN NEXT loop
1314               IF upper$(in2$(1 TO 6))="#ENDIF" THEN EXIT loop
1315             END REPeat loop
1316           END IF
1317         ELSE
1318           rec_range
1319           PRINT #4,line_num;" ";in$
1320           line_num = line_num + line_delta
1321         END IF
1322       END IF
1323     END IF
1324   END REPeat pass_2
1325   CLOSE #file_num
1326 END DEFine pass_two_file
