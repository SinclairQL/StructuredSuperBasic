1719 DEFine PROCedure rec_statement(text$)
1720   LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
1721   LOCal rs_b(64),rs_e(64),rs_n,i,j,k,b,depth,cut,thenat,elseat,endat,kind$(64),s$(1024),v,before
1722   LOCal rd_name$(64),rd_shape$(1024),rd_rank,rd_type,rd_val,rd_pool
1723   LOCal vw_var,vw_type,vw_rank,vw_end,vw_leaf,vw_sel$(1024),vw_prefix$(160)
1724   LOCal remaining$(1000)
1725   remaining$=text$
1726   rec_lex remaining$
1727   IF rk_n=0 THEN
1728     IF d_ignore$<>"Y" THEN rec_put ":"
1729     RETurn
1730   END IF
1731   kind$=rec_upper$(rec_token$(1)): b=rk_n
1732   IF kind$=CHR$(64) THEN rec_put remaining$: RETurn
1733   IF kind$="TYPE" THEN rc_type=1: RETurn
1734   IF kind$="END" AND rec_upper$(rec_token$(2))="TYPE" THEN rc_type=0: RETurn
1735   IF rc_type THEN RETurn
1736   IF rk_kind(1)=5 THEN
1737     IF kind$="DATA" THEN rec_data remaining$
1738     rec_put remaining$: RETurn
1739   END IF
1740   IF rk_kind(b)=5 THEN b=b-1
1741   IF b=0 THEN rec_put remaining$: RETurn
1742   IF kind$="DEFINE" OR kind$="DEF" THEN
1743     rc_routine=rec_find(rec_token$(3),rr_name$,rr_n): rec_header rc_routine: RETurn
1744   END IF
1745   IF kind$="END" AND (rec_upper$(rec_token$(2))="DEFINE" OR rec_upper$(rec_token$(2))="DEF") THEN
1746     rec_put remaining$: rc_routine=0: RETurn
1747   END IF
1748   IF kind$="REFERENCE" THEN RETurn
1749   IF kind$="IF" THEN
1750     depth=0: thenat=0: elseat=0: endat=0
1751     FOR i=2 TO b
1752       IF rec_token$(i)="(" THEN depth=depth+1
1753       IF rec_token$(i)=")" THEN depth=depth-1
1754       IF depth=0 THEN
1755         IF rec_upper$(rec_token$(i))="THEN" AND NOT thenat THEN thenat=i
1756         IF thenat AND rec_upper$(rec_token$(i))="IF" THEN
1757           IF rec_upper$(rec_token$(i-1))<>"END" THEN rec_fail "Use multiline form for nested inline IF"
1758         END IF
1759         IF rec_upper$(rec_token$(i))="ELSE" THEN
1760           IF elseat THEN rec_fail "Use multiline form for nested inline IF"
1761           elseat=i
1762         END IF
1763         IF rec_upper$(rec_token$(i))="END" AND i<b THEN
1764           IF rec_upper$(rec_token$(i+1))="IF" THEN endat=i
1765         END IF
1766       END IF
1767     END FOR i
1768     IF NOT thenat THEN rec_fail "Record profile requires THEN in IF statements"
1769     IF thenat=b-1 AND rec_token$(b)=":" THEN rec_fail "Put THEN last on a multiline IF header"
1770     rec_put "IF " & rec_expr$(rec_part$(2,thenat-1)) & " THEN"
1771     IF thenat=b THEN RETurn
1772     j=b: IF endat THEN j=endat-1
1773     IF elseat THEN
1774       rec_statement rec_part$(thenat+1,elseat-1): rec_put "ELSE"
1775       rec_statement rec_part$(elseat+1,j)
1776     ELSE
1777       rec_statement rec_part$(thenat+1,j)
1778     END IF
1779     rec_put "END IF": RETurn
1780   END IF
1781   depth=0: cut=0
1782   FOR i=1 TO b
1783     IF rec_token$(i)="(" THEN depth=depth+1
1784     IF rec_token$(i)=")" THEN depth=depth-1
1785     IF rec_token$(i)=":" AND depth=0 THEN cut=i: EXIT i
1786   END FOR i
1787   IF cut THEN
1788     IF kind$="=" THEN
1789       before=rc_temp: s$=rec_expr$(rec_part$(1,cut-1))
