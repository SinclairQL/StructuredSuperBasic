841 DEFine PROCedure rec_discover(text$)
842   LOCal i,j,n,depth,previous$(1024),word$(1024),first$(1024),quote$(1024),c$(1024)
843   i=1: n=0: depth=0: previous$="": quote$="": first$=""
844   REPeat rec_discovery
845     IF i>LEN(text$) THEN RETurn
846     c$=text$(i)
847     IF quote$<>"" THEN
848       IF c$=quote$ THEN quote$=""
849       i=i+1: NEXT rec_discovery
850     END IF
851     IF c$='"' OR c$="'" THEN quote$=c$: i=i+1: NEXT rec_discovery
852     IF i<LEN(text$) THEN
853       IF text$(i TO i+1)="##" OR text$(i TO i+1)="**" THEN RETurn
854     END IF
855     IF rec_letter(c$) THEN
856       j=i
857       REPeat rec_discovery_word
858         IF j=LEN(text$) THEN EXIT rec_discovery_word
859         IF NOT rec_namechar(text$(j+1)) THEN EXIT rec_discovery_word
860         j=j+1
861       END REPeat rec_discovery_word
862       word$=rec_upper$(text$(i TO j)): n=n+1
863       IF n=1 THEN
864         first$=word$
865         IF first$="TYPE" THEN rc_enabled=1: RETurn
866         IF first$<>"DIM" AND first$<>"LOCAL" AND first$<>"DEF" AND first$<>"DEFINE" THEN RETurn
867       ELSE
868         IF word$="AS" AND n>2 AND previous$<>"" AND previous$<>"(" AND previous$<>"," THEN
869           IF depth=0 AND (first$="DIM" OR first$="LOCAL") THEN rc_enabled=1: RETurn
870           IF n>3 AND (first$="DEFINE" OR first$="DEF") THEN rc_enabled=1: RETurn
871         END IF
872         IF word$="VAL" AND n>3 AND (first$="DEFINE" OR first$="DEF") THEN rc_enabled=1: RETurn
873       END IF
874       previous$=word$: i=j+1
875     ELSE
876       IF c$="(" THEN depth=depth+1
877       IF c$=")" THEN depth=depth-1
878       IF c$<>" " AND c$<>CHR$(9) THEN previous$=c$
879       i=i+1
880     END IF
881   END REPeat rec_discovery
882 END DEFine rec_discover
