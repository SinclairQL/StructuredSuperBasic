1093       END IF
1094       rm_name$(v)=rec_upper$(rec_token$(i)): rm_value(v)=rec_token$(i+2)
1095     END IF
1096   END IF
1097   IF kind$="FOR" AND b>3 THEN
1098     IF rec_token$(3)="=" THEN rec_user rec_token$(2),1
1099   END IF
1100   IF kind$="IMPLICIT%" OR kind$="IMPLICIT$" THEN
1101     FOR i=2 TO b
1102       IF rk_kind(i)=1 THEN
1103         rec_user rec_token$(i),1
1104       ELSE
1105         IF rec_token$(i)<>"," THEN rec_fail "Use an explicit IMPLICIT name list"
1106       END IF
1107     END FOR i
1108     RETurn
1109   END IF
1110   IF kind$="DIM" OR kind$="LOCAL" THEN
1111     rec_split 2,b
1112     FOR i=1 TO rs_n
1113       a=rs_b(i): n=0
1114       FOR j=a TO rs_e(i)
1115         IF rec_upper$(rec_token$(j))="AS" THEN n=1
1116       END FOR j
1117       IF n THEN
1118         rec_descriptor a,rs_e(i),0
1119         IF kind$="LOCAL" AND NOT rc_routine THEN rec_fail "LOCal record outside a routine"
1120         v=rec_variable(rd_name$,rd_type,rd_rank)
1121         IF kind$="LOCAL" THEN
1122           n=0
1123           FOR k=1 TO rc_locals
1124             IF rc_lr(k)=rc_routine AND rc_lv(k)=v THEN n=1
1125           END FOR k
1126           IF NOT n THEN
1127           rec_room rc_locals,rc_cap,"Local record"
1128           rc_locals=rc_locals+1: rc_lr(rc_locals)=rc_routine: rc_lv(rc_locals)=v
1129           END IF
1130         END IF
1131         IF rd_pool THEN
1132           IF kind$<>"DIM" OR rc_routine THEN rec_fail "POOL must be global"
1133           rv_pool(v)=1
1134         END IF
1135       ELSE
1136         rec_user rec_token$(a),1
1137         IF kind$="LOCAL" AND rc_routine THEN rr_simplelocals(rc_routine)=rr_simplelocals(rc_routine)+1
1138         IF a<rs_e(i) THEN
1139           IF rec_token$(a+1)="(" THEN rn_array(rec_find(rec_token$(a),rn_name$,rn_n))=1
1140         END IF
1141       END IF
1142     END FOR i
1143   END IF
1144   FOR i=1 TO b
1145     IF rk_kind(i)=1 THEN
1146       n=1
1147       IF i>1 THEN
1148         IF rec_token$(i-1)="." OR rec_upper$(rec_token$(i-1))="AS" THEN n=0
1149       END IF
1150       IF n THEN rec_user rec_token$(i),0
1151     END IF
1152   END FOR i
1153   IF b>1 AND rk_kind(1)=1 AND rec_token$(2)="=" THEN rn_assignment(rec_find(rec_token$(1),rn_name$,rn_n))=1
