1499     IF ra_var(p) THEN
1500       rec_view rs_b(i),rs_e(i)
1501       v=vw_var: n=vw_type: prefix$=vw_prefix$
1502       IF vw_sel$<>"" THEN
1503         FOR j=1 TO rl_n
