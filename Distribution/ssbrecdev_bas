1225 DEFine PROCedure pass_two_file (in_file$, file_num)
1226   LOCal in3$(100), a$(100), space$(1), rem$(2)
1227   LOCal comm$(2), at$(1), lab$(1), cont$(2)
1228   rem$ = CHR$(42) & CHR$(42): REMark REMark flag.
1229   comm$ = CHR$(35) & CHR$(35): REMark Comment flag, ignore these lines.
1230   lab$ = CHR$(64): REMark Label flag. 
1231   cont$ = "\+": REMark Continuation flag, join this to the next line(s).
1232   OPEN_IN #file_num,in_file$
1233   REPeat pass_2
1234     num_count = num_count + 1
1235     IF (num_count MOD 10) = 0 THEN PRINT #3,CHR$(1);
1236     IF EOF(#file_num) THEN EXIT pass_2
1237     INPUT #file_num,in$
1238     rec_origin
1239     rec_range
1240     in$ = stripTab$(in$)  
1241     temp=first_char(in$)
1242     IF temp=0 THEN
1243       IF d_ignore$ == "Y" THEN
1244         NEXT pass_2
1245       ELSE
1246         print #4, line_num; " :"           
1247         line_num = line_num + line_delta
1248           rec_range
1249         next pass_2
1250       END IF
1251     END IF
1252     IF in$(1) = lab$ THEN NEXT pass_2: END IF
1253     IF in$(temp TO temp + 1) = comm$ THEN NEXT pass_2: END IF
1254     IF in$(temp) = "." THEN NEXT pass_2: END IF
1255     IF in$(LEN(in$)-1 TO) = "\+" THEN
1256       REMark Join lines until we have the complete line.
1257       REMark ready for further processing.
1258       in$ = joinLine$(in$)
1259     END IF
1260     IF comm$ INSTR in$ THEN
1261       in$ = stripComment$(in$)
1262     END IF
1263     IF rem$ INSTR in$ THEN
1264       in$ = doRemark$(in$)
1265     END IF
1266     IF upper$(in$(1 TO 7))="#DEFINE" THEN NEXT pass_2: END IF
1267     IF LEN(in$) >= 6 THEN
1268       IF in$(1 TO 6) = "#ENDIF" THEN NEXT pass_2: END IF
1269     END IF
1270     temp = lab$ INSTR in$
1271     IF rc_enabled THEN temp=rec_labelref(in$)
1272     IF temp<>0 THEN
1273       a$ = in$(temp TO )
1274       temp2 = 0
1275       REPEAT loop2
1276         temp2 = temp2 + 1
1277         IF temp2 > d_labels THEN
1278           BEEP 1000,10
1279           INK #3,2
1280           PRINT #3,lngarray$(35);a$;lngarray$(32)
1281           PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
1282           abort_out
1283         END IF
1284         IF label$(temp2) == a$ THEN EXIT loop2
1285       END REPEAT loop2
1286       PRINT #4,line_num;" ";in$(1 TO temp-1);label(temp2)
1287       line_num = line_num + line_delta
1288           rec_range
1289     ELSE
1290       IF upper$(in$(1 to 8))="#INCLUDE" THEN
1291         pass_two_file d_working$&in$(10 to), file_num+1
1292       ELSE
1293         IF upper$(in$(1 TO 6))="#IFDEF" THEN
1294           temp = 0
1295           temp$ = upper$(in$(8 TO))
1296           FOR x = 1 TO define_var
1297             IF temp$ = defn$((x),1 TO LEN(temp$)) THEN temp = x
1298           END FOR X
1299           IF temp = 0 THEN
1300             REPEAT loop
1301               INPUT #file_num,in2$
1302               IF LEN(in2$) < 6 THEN NEXT loop
1303               IF upper$(in2$(1 TO 6))="#ENDIF" THEN EXIT loop
1304             END REPeat loop
1305           END IF
1306         ELSE
1307           PRINT #4,line_num;" ";in$
1308           line_num = line_num + line_delta
1309           rec_range
1310         END IF
1311       END IF
1312     END IF
1313   END REPeat pass_2
1314   CLOSE #file_num
1315 END DEFine pass_two_file
