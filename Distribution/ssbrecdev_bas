2101 DEFine PROCedure rec_lex(text$)
2102   LOCal i,j,c$(160),q$(1),depth
2103   rk_line$=text$: rk_n=0: i=1
2104   REPeat rec_scan
2105     IF i>LEN(text$) THEN EXIT rec_scan
2106     c$=text$(i)
2107     IF c$=" " OR c$=CHR$(9) THEN i=i+1: NEXT rec_scan
2108     IF rk_n=256 THEN rec_fail "Too many tokens on one line"
2109     rk_n=rk_n+1: rk_s(rk_n)=i: rk_kind(rk_n)=4
2110     j=i
2111     IF c$='"' OR c$="'" THEN
2112       rk_kind(rk_n)=3: q$=c$: j=i+1
2113       REPeat rec_quote
2114         IF j>LEN(text$) THEN rec_fail "Unterminated quoted string"
2115         IF text$(j)=q$ THEN EXIT rec_quote
2116         j=j+1
2117       END REPeat rec_quote
2118     ELSE
2119       IF rec_letter(c$) THEN
2120         rk_kind(rk_n)=1
2121         REPeat rec_ident
2122           IF j=LEN(text$) THEN EXIT rec_ident
2123           IF NOT rec_namechar(text$(j+1)) THEN EXIT rec_ident
2124           j=j+1
2125         END REPeat rec_ident
2126         IF j<LEN(text$) THEN
2127           IF text$(j+1)="$" OR text$(j+1)="%" THEN j=j+1
2128         END IF
2129       ELSE
2130         IF rec_digit(c$) OR c$="$" OR c$="%" THEN
2131           rk_kind(rk_n)=2
2132           REPeat rec_number
2133             IF j=LEN(text$) THEN EXIT rec_number
2134             c$=rec_upper$(text$(j+1))
2135             IF NOT rec_namechar(c$) AND c$<>"." THEN EXIT rec_number
2136             j=j+1
2137             IF c$="E" AND j<LEN(text$) THEN
2138               IF text$(j+1)="+" OR text$(j+1)="-" THEN j=j+1
2139             END IF
2140           END REPeat rec_number
2141         END IF
2142       END IF
2143     END IF
2144     rk_e(rk_n)=j
2145     IF rk_kind(rk_n)=3 THEN
2146       rk_len%(rk_n)=1
2147     ELSE
2148       IF j-i>159 THEN rec_fail "Identifier/number token exceeds 160 bytes"
2149       rk_len%(rk_n)=j-i+1
2150     END IF
2151     c$=rec_upper$(rec_token$(rk_n))
2152     IF c$="REMARK" OR c$="REM" OR c$="DATA" THEN
2153       rk_e(rk_n)=LEN(text$): rk_len%(rk_n)=LEN(c$): rk_kind(rk_n)=5
2154       EXIT rec_scan
2155     END IF
2156     IF j<LEN(text$) THEN
2157       c$=text$(j TO j+1)
2158       IF c$="##" OR c$="**" THEN
2159         rk_e(rk_n)=LEN(text$): rk_len%(rk_n)=LEN(c$): rk_kind(rk_n)=5
2160         EXIT rec_scan
2161       END IF
2162     END IF
2163     i=j+1
2164   END REPeat rec_scan
2165 END DEFine rec_lex
2166 DEFine FuNction rec_token$(tokenIndex)
2167   LOCal first,last
2168   IF tokenIndex<1 OR tokenIndex>rk_n THEN RETurn ""
2169   first=rk_s(tokenIndex): last=first+rk_len%(tokenIndex)-1
2170   IF rk_kind(tokenIndex)=5 THEN RETurn rec_upper$(rk_line$(first TO last))
2171   RETurn rk_line$(first TO last)
