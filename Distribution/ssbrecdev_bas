750 DEFine PROCedure rec_select(source$,channel)
751   LOCal text$(1000),next$(1000),raw$(1000),sourceLine,origin,i,j,key$(64),symbol$(100),savedif
752   IF channel>23 THEN rec_fail "Include depth exceeds reserved input channels 5..23"
753   IF FOP_IN(#channel,source$)<0 THEN rec_fail "Cannot open include/source: " & source$
754   file_num=channel: sourceLine=0: savedif=rc_ifn
755   REPeat rec_read_source
756     IF EOF(#channel) THEN EXIT rec_read_source
757     INPUT #channel,text$: sourceLine=sourceLine+1: origin=sourceLine
758     text$=stripTab$(text$)
759     REPeat rec_join_source
760       IF LEN(text$)<2 THEN EXIT rec_join_source
761       IF text$(LEN(text$)-1 TO)<>"\+" THEN EXIT rec_join_source
762       IF EOF(#channel) THEN rec_fail "Continuation at end of file"
763       INPUT #channel,next$: sourceLine=sourceLine+1
764       text$=text$(TO LEN(text$)-2) & " " & rec_ltrim$(next$)
765       IF LEN(text$)>1000 THEN rec_fail "Joined source sourceLine exceeds 1000 bytes"
766     END REPeat rec_join_source
767     rc_file$=source$: rc_line=origin
768     raw$=rec_trim$(text$)
769     IF raw$="" THEN
770       IF rc_active AND d_ignore$<>"Y" THEN rec_spoolline text$
771       NEXT rec_read_source
772     END IF
773     IF raw$(1)="." THEN NEXT rec_read_source
774     IF raw$(1)="#" AND raw$(1 TO 2)<>"##" THEN
775       i=" " INSTR raw$: IF NOT i THEN i=LEN(raw$)+1
776       key$=rec_upper$(raw$(1 TO i-1)): symbol$=""
777       IF i<LEN(raw$) THEN symbol$=rec_trim$(raw$(i+1 TO))
778       IF key$="#ENDIF" THEN
779         IF rc_ifn=savedif THEN rec_fail "#ENDIF without #IFDEF in this file"
780         rc_active=rc_if(rc_ifn): rc_ifn=rc_ifn-1: NEXT rec_read_source
781       END IF
782       IF key$="#IFDEF" THEN
783         IF rc_ifn=32 THEN rec_fail "Conditional nesting exceeds 32"
784         rc_ifn=rc_ifn+1: rc_if(rc_ifn)=rc_active
785         IF NOT rec_find(rec_upper$(symbol$),rc_def$,rc_defn) THEN rc_active=0
786         NEXT rec_read_source
787       END IF
788       IF NOT rc_active THEN NEXT rec_read_source
789       IF key$="#DEFINE" THEN
790         IF rc_defn=d_labels THEN rec_fail "Too many #DEFINE symbols"
791         IF LEN(symbol$)>d_length THEN rec_fail "#DEFINE symbol too long"
792         rc_defn=rc_defn+1: rc_def$(rc_defn)=rec_upper$(symbol$): NEXT rec_read_source
793       END IF
794       IF key$="#INCLUDE" THEN rec_select d_working$ & symbol$,channel+1: NEXT rec_read_source
795     END IF
796     IF NOT rc_active THEN NEXT rec_read_source
797     IF NOT rc_enabled THEN rec_discover text$
798     rec_spoolline text$
799   END REPeat rec_read_source
800   IF rc_ifn<>savedif THEN rec_fail "#IFDEF crosses file boundary"
801   CLOSE #channel: file_num=channel-1
802 END DEFine rec_select
