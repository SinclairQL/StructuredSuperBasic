1721 DEFine PROCedure rec_statement(text$)
1722   LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
1723   LOCal rs_b(64),rs_e(64),rs_n,i,j,k,b,depth,cut,thenat,elseat,endat,kind$(64),s$(1024),v,before
1724   LOCal rd_name$(64),rd_shape$(1024),rd_rank,rd_type,rd_val,rd_pool
1725   LOCal vw_var,vw_type,vw_rank,vw_end,vw_leaf,vw_sel$(1024),vw_prefix$(160)
1726   LOCal remaining$(1000)
1727   remaining$=text$
1728   rec_lex remaining$
1729   IF rk_n=0 THEN
1730     IF d_ignore$<>"Y" THEN rec_put ":"
1731     RETurn
1732   END IF
1733   kind$=rec_upper$(rec_token$(1)): b=rk_n
1734   IF kind$=CHR$(64) THEN rec_put remaining$: RETurn
1735   IF kind$="TYPE" THEN rc_type=1: RETurn
1736   IF kind$="END" AND rec_upper$(rec_token$(2))="TYPE" THEN rc_type=0: RETurn
1737   IF rc_type THEN RETurn
1738   IF rk_kind(1)=5 THEN
1739     IF kind$="DATA" THEN rec_data remaining$
1740     rec_put remaining$: RETurn
1741   END IF
1742   IF rk_kind(b)=5 THEN b=b-1
1743   IF b=0 THEN rec_put remaining$: RETurn
1744   IF kind$="DEFINE" OR kind$="DEF" THEN
1745     rc_routine=rec_find(rec_token$(3),rr_name$,rr_n): rec_header rc_routine: RETurn
1746   END IF
1747   IF kind$="END" AND (rec_upper$(rec_token$(2))="DEFINE" OR rec_upper$(rec_token$(2))="DEF") THEN
1748     rec_put remaining$: rc_routine=0: RETurn
1749   END IF
1750   IF kind$="REFERENCE" THEN RETurn
1751   IF kind$="IF" THEN
1752     depth=0: thenat=0: elseat=0: endat=0
1753     FOR i=2 TO b
1754       IF rec_token$(i)="(" THEN depth=depth+1
1755       IF rec_token$(i)=")" THEN depth=depth-1
1756       IF depth=0 THEN
1757         IF rec_upper$(rec_token$(i))="THEN" AND NOT thenat THEN thenat=i
1758         IF thenat AND rec_upper$(rec_token$(i))="IF" THEN
1759           IF rec_upper$(rec_token$(i-1))<>"END" THEN rec_fail "Use multiline form for nested inline IF"
1760         END IF
1761         IF rec_upper$(rec_token$(i))="ELSE" THEN
1762           IF elseat THEN rec_fail "Use multiline form for nested inline IF"
1763           elseat=i
1764         END IF
1765         IF rec_upper$(rec_token$(i))="END" AND i<b THEN
1766           IF rec_upper$(rec_token$(i+1))="IF" THEN endat=i
1767         END IF
1768       END IF
1769     END FOR i
1770     IF NOT thenat THEN rec_fail "Record profile requires THEN in IF statements"
1771     IF thenat=b-1 AND rec_token$(b)=":" THEN rec_fail "Put THEN last on a multiline IF header"
1772     rec_put "IF " & rec_expr$(rec_part$(2,thenat-1)) & " THEN"
1773     IF thenat=b THEN RETurn
1774     j=b: IF endat THEN j=endat-1
1775     IF elseat THEN
1776       rec_statement rec_part$(thenat+1,elseat-1): rec_put "ELSE"
1777       rec_statement rec_part$(elseat+1,j)
1778     ELSE
1779       rec_statement rec_part$(thenat+1,j)
1780     END IF
1781     rec_put "END IF": RETurn
1782   END IF
1783   depth=0: cut=0
1784   FOR i=1 TO b
1785     IF rec_token$(i)="(" THEN depth=depth+1
1786     IF rec_token$(i)=")" THEN depth=depth-1
1787     IF rec_token$(i)=":" AND depth=0 THEN cut=i: EXIT i
1788   END FOR i
1789   IF cut THEN
1790     IF kind$="=" THEN
1791       before=rc_temp: s$=rec_expr$(rec_part$(1,cut-1))
1792       IF rc_temp<>before THEN rec_fail "Split record argument captures out of SELECT case values"
1793       rec_put s$ & ":": remaining$=rec_part$(cut+1,rk_n): GO TO 1728
1794     END IF
1795     IF kind$="FOR" OR kind$="REPEAT" OR kind$="REP" THEN
1796       FOR j=cut+1 TO b-1
1797         IF rec_upper$(rec_token$(j))="END" THEN
1798           IF rec_upper$(rec_token$(j+1))=kind$ THEN rec_fail "Use multiline form for explicitly closed inline loops"
1799         END IF
1800       END FOR j
1801       rec_statement rec_part$(1,cut-1)
1802       rec_statement rec_part$(cut+1,rk_n)
1803       rec_put "END " & rec_token$(1) & " " & rec_expr$(rec_token$(2)): RETurn
1804     END IF
1805     IF cut>1 THEN rec_statement rec_part$(1,cut-1)
1806     IF cut<rk_n THEN remaining$=rec_part$(cut+1,rk_n): GO TO 1728
1807     RETurn
1808   END IF
1809   IF kind$="DIM" OR kind$="LOCAL" THEN
1810     rec_split 2,b
1811     FOR i=1 TO rs_n
1812       k=0
1813       FOR j=rs_b(i) TO rs_e(i)
1814         IF rec_upper$(rec_token$(j))="AS" THEN k=1
1815       END FOR j
1816       IF k THEN
1817         rec_descriptor rs_b(i),rs_e(i),0
1818         v=rec_find(rd_name$,rv_name$,rv_n)
1819         rec_storage v,rd_shape$,rd_pool
1820       ELSE
1821         s$=rec_part$(rs_b(i),rs_e(i))
1822         IF rec_find(rec_token$(rs_b(i)),rv_name$,rv_n) THEN rec_fail "Cannot independently dimension record storage"
1823         rec_put rec_token$(1) & " " & rec_expr$(s$)
1824       END IF
1825     END FOR i
1826     RETurn
1827   END IF
1828   rec_view 1,b
1829   IF vw_var AND NOT vw_leaf THEN
1830     i=vw_end+1
1831     IF i>b OR rec_token$(i)<>"=" THEN rec_fail "Whole record requires an assignment or typed parameter"
1832     rec_copy rec_part$(1,vw_end),rec_part$(i+1,b): RETurn
1833   END IF
1834   v=rec_find(rec_token$(1),rr_name$,rr_n)
1835   IF v AND NOT rr_fun(v) THEN
1836     i=2: j=b
1837     IF i<=b AND rec_token$(i)="(" THEN j=rec_match(i,b)-1: i=i+1
1838     s$=rec_arguments$(v,rec_part$(i,j),0)
1839     IF s$<>"" THEN s$=" " & s$
1840     rec_put rec_token$(1) & s$: RETurn
1841   END IF
1842   IF kind$="FOR" THEN
1843     rec_view 2,b
1844     IF vw_var AND (NOT vw_leaf OR vw_sel$<>"") THEN rec_fail "FOR counter must be a simple scalar field"
1845     IF vw_leaf THEN
1846       IF rl_rank(vw_leaf)<>0 OR rec_isstring(rl_path$(vw_leaf)) THEN rec_fail "FOR counter must be a numeric scalar field"
1847     END IF
1848   END IF
1849   IF kind$="PRINT" OR kind$="RETURN" OR kind$="RET" THEN
1850     before=rc_temp: s$=rec_expr$(rec_part$(2,rk_n))
1851     rec_put rec_token$(1) & " " & s$: RETurn
1852   END IF
1853   IF b>2 AND rk_kind(1)=1 AND rec_token$(2)="=" THEN
1854     rec_put rec_token$(1) & " = " & rec_expr$(rec_part$(3,rk_n)): RETurn
1855   END IF
1856   rec_put rec_expr$(remaining$)
1857 END DEFine rec_statement
1858 DEFine PROCedure rec_data(text$)
