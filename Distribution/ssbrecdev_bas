959 DEFine FuNction rec_bound$(a,b,stringcap)
960   LOCal v,i,s$(1024)
961   s$=rec_part$(a,b)
962   IF a=b AND rk_kind(a)=2 AND isnum(s$) THEN
963     v=s$
964   ELSE
965     i=rec_find(s$,rm_name$,rm_n)
966     IF NOT i THEN rec_fail "Field bound needs an integer literal or numeric MANIFEST: " & s$
967     v=rm_value(i)
968   END IF
969   IF v<0 OR v>32767 OR v<>INT(v) OR (stringcap AND v=0) THEN rec_fail "Invalid fixed field bound: " & s$
970   RETurn rec_num$(v)
971 END DEFine rec_bound$
972 DEFine PROCedure rec_descriptor(a,b,formal)
973   LOCal i,j,last,rs_b(64),rs_e(64),rs_n,asat
974   rd_name$=rec_token$(a): rd_shape$="": rd_rank=0: rd_type=0: rd_val=0: rd_pool=0
975   IF rec_upper$(rd_name$)="VAL" THEN
976     rd_val=1: a=a+1: rd_name$=rec_token$(a)
977   END IF
978   IF rk_kind(a)<>1 THEN rec_fail "Expected a declared name"
979   IF LEN(rd_name$)>64 THEN rec_fail "Declared names are limited to 64 bytes"
980   i=a+1
981   IF i<=b THEN
982     IF rec_token$(i)="(" THEN
983       j=rec_match(i,b): rd_shape$=rec_part$(i+1,j-1)
984       IF formal THEN
985         FOR last=i+1 TO j-1
986           IF rec_token$(last)<>"," THEN rec_fail "Record array formals use empty dimensions"
987         END FOR last
988         rd_rank=1
989         FOR last=i+1 TO j-1
990           rd_rank=rd_rank+1
991         END FOR last
992       ELSE
993         rec_split i+1,j-1: rd_rank=rs_n
994         IF NOT rs_n THEN rec_fail "Record storage arrays need dimension bounds"
995       END IF
996       i=j+1
997     END IF
998   END IF
999   IF i<=b THEN
1000     IF rec_upper$(rec_token$(i))<>"AS" OR i+1>b THEN rec_fail "Expected AS recordType"
1001     rd_type=rec_typeid(rec_token$(i+1)): i=i+2
1002   END IF
1003   IF i<=b THEN
1004     IF rec_upper$(rec_token$(i))<>"POOL" OR i<>b THEN rec_fail "Unexpected text after record declaration"
1005     rd_pool=1: i=i+1
1006   END IF
1007   IF rd_val AND (rd_type OR rd_rank) THEN rec_fail "VAL supports scalar numbers and strings only"
1008   IF rd_pool AND (formal OR NOT rd_type OR rd_rank<>1) THEN rec_fail "POOL requires a global one-dimensional record array"
1009 END DEFine rec_descriptor
1010 DEFine PROCedure rec_collect(text$)
1011   LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
1012   LOCal rs_b(64),rs_e(64),rs_n,i,j,k,a,b,kind$(1024),name$(1024),n,v
1013   LOCal rd_name$(64),rd_shape$(1024),rd_rank,rd_type,rd_val,rd_pool
1014   rec_lex text$
1015   IF rk_n=0 THEN RETurn
1016   kind$=rec_upper$(rec_token$(1))
1017   IF rk_kind(1)=5 OR kind$=CHR$(64) THEN RETurn
1018   b=rk_n: IF rk_kind(b)=5 THEN b=b-1
1019   IF kind$="TYPE" THEN
1020     IF rc_type OR rc_routine OR b<>2 THEN rec_fail "TYPE must be a top-level declaration"
1021     rc_type=rec_typeid(rec_token$(2))
1022     IF rt_defined(rc_type) THEN rec_fail "Duplicate TYPE: " & rec_token$(2)
1023     rt_defined(rc_type)=1: RETurn
1024   END IF
1025   IF kind$="END" AND rec_upper$(rec_token$(2))="TYPE" THEN
1026     IF NOT rc_type THEN rec_fail "END TYPE without TYPE"
1027     rc_type=0: RETurn
1028   END IF
1029   IF kind$="REFERENCE" AND NOT rc_type THEN
1030     RETurn
1031   END IF
1032   IF rc_type THEN
1033     rec_descriptor 1,b,0
1034     IF rd_val OR rd_pool THEN rec_fail "Invalid TYPE field"
1035     FOR i=1 TO rf_n
1036       IF rf_owner(i)=rc_type AND rec_upper$(rf_name$(i))=rec_upper$(rd_name$) THEN rec_fail "Duplicate field: " & rd_name$
1037     END FOR i
1038     rec_room rf_n,rc_cap,"Field"
1039     rf_n=rf_n+1: rf_owner(rf_n)=rc_type: rf_name$(rf_n)=rec_upper$(rd_name$): rf_type(rf_n)=rd_type
1040     IF rd_type THEN
1041       IF rd_rank THEN rec_fail "Arrays of embedded records are not supported"
1042     ELSE
1043       IF rd_name$(LEN(rd_name$))="$" AND NOT rd_rank THEN rec_fail "String fields require a capacity"
1044       IF rd_rank THEN
1045         rec_split 3,b-1: rd_shape$=""
1046         FOR i=1 TO rs_n
1047           v=rd_name$(LEN(rd_name$))="$" AND i=rs_n
1048           rd_shape$=rec_join$(rd_shape$,rec_bound$(rs_b(i),rs_e(i),v))
1049         END FOR i
1050       END IF
1051       rf_shape$(rf_n)=rd_shape$: rf_rank(rf_n)=rd_rank
1052       IF rd_name$(LEN(rd_name$))="$" THEN rf_rank(rf_n)=rd_rank-1
1053     END IF
1054     RETurn
1055   END IF
1056   IF kind$="DEFINE" OR kind$="DEF" THEN
