1076           rec_user rd_name$,1
1077         END IF
1078         rr_count(rr_n)=rr_count(rr_n)+1
1079       END FOR i
1080     END IF
1081     RETurn
1082   END IF
1083   IF kind$="END" AND (rec_upper$(rec_token$(2))="DEFINE" OR rec_upper$(rec_token$(2))="DEF") THEN
1084     rc_routine=0: RETurn
1085   END IF
1086   IF kind$="MANIFEST" THEN
1087     i=2: IF rec_token$(i)=":" THEN i=i+1
1088     IF b=i+2 AND rec_token$(i+1)="=" AND isnum(rec_token$(i+2)) THEN
1089       v=rec_find(rec_token$(i),rm_name$,rm_n)
