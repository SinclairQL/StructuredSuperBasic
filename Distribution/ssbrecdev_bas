1657 DEFine PROCedure rec_header(routine)
1658   LOCal p,v,j,i,count,s$(1024),ref$(1024),name$(320),localcount
1659   s$="": ref$="": count=0
1660   localcount=rr_simplelocals(routine)+rr_temps(routine)
