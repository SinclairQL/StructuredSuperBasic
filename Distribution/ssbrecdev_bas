620 DEFine PROCedure pass_one_file (in_file$, file_num)
621   errorx = FOP_IN(#file_num,in_file$)
622   INK #3,2
623   IF errorx = -12 THEN
624     BEEP 1000,10
625     PRINT #3,lngarray$(21);in_file$
626     abort_out
627   END IF
628   IF errorx = -7 THEN
629     BEEP 1000,10
630     PRINT #3,lngarray$(22);in_file$
631     abort_out
632   END IF
633   IF errorx = -9 THEN
634     BEEP 1000,10
635     PRINT #3,lngarray$(23);in_file$
636     abort_out
637   END IF
638   INK #3,4
639   REPeat pass_1
640     num_count = num_count + 1
641     IF (num_count MOD 10) = 0 THEN PRINT #3,CHR$(1);
642     IF EOF(#file_num) THEN EXIT pass_1
643     INPUT #file_num,in$
644     rec_origin
645     rec_range
646     temp=first_char(in$)
647     IF temp=0 THEN NEXT pass_1
648     IF in$(temp TO temp+1)=CHR$(35)&CHR$(35) THEN NEXT pass_1
649     IF in$(temp)="." THEN NEXT pass_1
650     IF LEN(in$) >= 6 THEN
651       IF in$(1 TO 6) = "#ENDIF" THEN NEXT pass_1
652     END IF
653     REPeat loop
654       IF in$(LEN(in$)-1 TO)="\+" THEN
655         IF EOF(#file_num) THEN
656           BEEP 1000,10
657           INK #3,2
658           PRINT #3,lngarray$(24)
659           PRINT #3,lngarray$(25);in_file$
660           abort_out
661         END IF
662         INPUT #file_num,in2$
663         temp = first_char(in2$)
664         in$ = in$( TO LEN(in$)-2) & " " & in2$(temp TO)
665       ELSE
666         EXIT loop
667       END IF
668     END REPeat loop
669     IF in$(1)=CHR$(64) THEN
670       IF LEN(in$) > d_length+1 THEN
671         BEEP 1000,10
672         INK #3,2
673         PRINT #3,lngarray$(26);in$;lngarray$(27)
674         PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
675         abort_out
676       END IF
677       IF label_var = d_labels THEN
678         BEEP 1000,10
679         INK #3,2
680         PRINT #3,lngarray$(30)
681         PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
682         abort_out
683       END IF
684       label$(label_var) = in$
685       label(label_var) = line_num
686       label_var = label_var + 1
687     ELSE
688       IF upper$(in$(1 TO 8))="#INCLUDE" THEN
689         pass_one_file d_working$&in$(10 to ), file_num+1
690       ELSE
691         IF upper$(in$(1 TO 7))="#DEFINE" THEN
692           IF LEN(in$(9 TO)) > d_length THEN
693             BEEP 1000,10
694             INK #3,2
695             PRINT #3,lngarray$(31);in$(9 TO);lngarray$(27)
696             PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
697             abort_out
698           END IF
699           IF define_var = d_labels THEN
700             BEEP 1000,10
701             INK #3,2
702             PRINT #3,lngarray$(33)
703             PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
704             abort_out
705           END IF
706           defn$(define_var) = upper$(in$( 9 TO))
707           define_var = define_var+1
708         ELSE
709           IF upper$(in$(1 TO 6))="#IFDEF" THEN
710             temp = 0
711             temp$ = upper$(in$(8 TO))
712             FOR x = 1 TO define_var
713               IF temp$ = defn$(x) THEN temp = 1
714             END FOR X
715             IF temp = 0 THEN
716               REPEAT loop
717                 IF EOF(#file_num) THEN
718                   BEEP 1000,10
719                   INK #3,2
720                   PRINT #3,lngarray$(34)
721                   PRINT #3,lngarray$(25);in_file$
722                   abort_out
723                 END IF
724                 INPUT #file_num,in2$
725                 IF LEN(in2$) < 6 THEN NEXT loop
726                 IF upper$(in2$(1 TO 6))="#ENDIF" THEN EXIT loop
727               END REPeat loop
728             END IF
729           ELSE
730             line_num = line_num + line_delta
731           rec_range
732           END IF
733         END IF
734       END IF
735     END IF
736   END REPeat pass_1
737   CLOSE #file_num
738 END DEFine pass_one_file
