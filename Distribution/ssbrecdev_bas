1528 DEFine FuNction rec_expr$(text$)
1529   LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
1530   LOCal i,j,v,pos,result$(1024),s$(1024),before
1531   LOCal vw_var,vw_type,vw_rank,vw_end,vw_leaf,vw_sel$(1024),vw_prefix$(160)
1532   rec_lex text$: i=1: pos=1: result$=""
1533   REPeat rec_expression
1534     IF i>rk_n THEN EXIT rec_expression
1535     IF rk_kind(i)=5 THEN EXIT rec_expression
1536     s$="": j=i
1537     IF rec_token$(i)="." THEN
1538       IF i=rk_n THEN rec_fail "Field selection from a function result is unsupported"
1539       IF rk_kind(i+1)<>2 THEN rec_fail "Field selection requires a declared record"
1540     END IF
1541     IF rk_kind(i)=1 THEN
1542       v=rec_find(rec_token$(i),rr_name$,rr_n)
1543       IF v AND i<rk_n AND rec_token$(i+1)="(" THEN
1544         IF NOT rr_fun(v) THEN rec_fail "A procedure call is not an expression"
1545         j=rec_match(i+1,rk_n): before=rc_temp
1546         s$=rec_token$(i) & "(" & rec_arguments$(v,rec_part$(i+2,j-1),1) & ")"
1547         IF rc_temp<>before AND (i<>1 OR j<>rk_n) THEN rec_fail "Split a record argument selector out of the surrounding expression"
1548       ELSE
1549         rec_view i,rk_n
1550         IF vw_var THEN
1551           IF NOT vw_leaf THEN rec_fail "Whole records are only valid in copies and record parameters"
1552           before=rc_temp
1553           s$=rec_access$(vw_var,vw_leaf,rec_expr$(vw_sel$)): j=vw_end
1554           IF rc_temp<>before THEN rec_fail "Split captured record arguments out of field subscripts"
1555         ELSE
1556           IF i<rk_n AND rec_token$(i+1)="." THEN rec_fail "Unknown record: " & rec_token$(i)
1557         END IF
1558       END IF
1559     END IF
1560     IF s$<>"" THEN
1561       IF rk_s(i)>pos THEN result$=result$ & text$(pos TO rk_s(i)-1)
1562       result$=result$ & s$: pos=rk_e(j)+1: i=j
1563     END IF
1564     i=i+1
1565   END REPeat rec_expression
1566   IF pos<=LEN(text$) THEN result$=result$ & text$(pos TO)
1567   RETurn result$
1568 END DEFine rec_expr$
