## Physical/logical lines reach 1000 bytes; compare every resulting character.
DIM lineText$(1000),expected$(1000)
OPEN_NEW #9,"win1_result"
WHEN ERRor
 REPORT #9
 PRINT #9,"TARGET RUNTIME ERROR"
 CLOSE #9
 OPEN_NEW #8,"win1_done":PRINT #8,"ERROR":CLOSE #8
 STOP
END WHEN
expected$ = FILL$("x",85) & "Z"
lineText$ = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxZ"
PRINT #9,"plain-100:";LEN(lineText$);",";(lineText$=expected$)
expected$ = FILL$("x",86) & "Z"
lineText$ = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxZ"
PRINT #9,"plain-101:";LEN(lineText$);",";(lineText$=expected$)
expected$ = FILL$("x",240) & "Z"
lineText$ = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxZ"
PRINT #9,"plain-255:";LEN(lineText$);",";(lineText$=expected$)
expected$ = FILL$("x",984) & "Z"
lineText$ = ""
PRINT #9,"plain-999:";LEN(lineText$);",";(lineText$=expected$)
expected$ = FILL$("x",985) & "Z"
lineText$ = ""
PRINT #9,"plain-1000:";LEN(lineText$);",";(lineText$=expected$)
expected$ = FILL$("x",963) & "Z"
lineText$ = "" ## ignored at the end
PRINT #9,"hidden-1000:";LEN(lineText$);",";(lineText$=expected$)
expected$ = "## first ** literal ## last " & FILL$("x",957) & "Z"
lineText$ = "## first ** literal ## last "
PRINT #9,"quoted-markers-1000:";LEN(lineText$);",";(lineText$=expected$)
expected$ = "It's ## literal ** text " & FILL$("x",948) & "Z"
lineText$ = "It's ## literal ** text " ## invisible
PRINT #9,"mixed-double-1000:";LEN(lineText$);",";(lineText$=expected$)
expected$ = 'He said " ## literal ** text ' & FILL$("x",943) & "Z"
lineText$ = 'He said " ## literal ** text ' ## invisible
PRINT #9,"mixed-single-1000:";LEN(lineText$);",";(lineText$=expected$)
expected$ = FILL$("x",959) & "Z"
lineText$ = "" : ** a visible remark
PRINT #9,"visible-996:";LEN(lineText$);",";(lineText$=expected$)
expected$ = FILL$("x",852) & "Z"
                                                                                                                        lineText$ = "" ## invisible
PRINT #9,"indented-1000:";LEN(lineText$);",";(lineText$=expected$)
expected$ = FILL$("x",587) & " " & FILL$("x",397) & "Z"
lineText$ = "\+
"
PRINT #9,"continuation-1000:";LEN(lineText$);",";(lineText$=expected$)
CLOSE #9
OPEN_NEW #9,"win1_done":PRINT #9,"OK":CLOSE #9
STOP
