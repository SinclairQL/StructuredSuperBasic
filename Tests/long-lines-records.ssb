## Physical/logical lines reach 1000 bytes; compare every resulting character.
TYPE longRecord
 text$(1000)
END TYPE
DIM lineRecord AS longRecord
DIM expected$(1000)
OPEN_NEW #9,"win1_result"
WHEN ERRor
 REPORT #9
 PRINT #9,"TARGET RUNTIME ERROR"
 CLOSE #9
 OPEN_NEW #8,"win1_done":PRINT #8,"ERROR":CLOSE #8
 STOP
END WHEN
expected$ = FILL$("x",78) & "Z"
lineRecord.text$ = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxZ"
PRINT #9,"plain-100:";LEN(lineRecord.text$);",";(lineRecord.text$=expected$)
expected$ = FILL$("x",79) & "Z"
lineRecord.text$ = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxZ"
PRINT #9,"plain-101:";LEN(lineRecord.text$);",";(lineRecord.text$=expected$)
expected$ = FILL$("x",233) & "Z"
lineRecord.text$ = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxZ"
PRINT #9,"plain-255:";LEN(lineRecord.text$);",";(lineRecord.text$=expected$)
expected$ = FILL$("x",977) & "Z"
lineRecord.text$ = ""
PRINT #9,"plain-999:";LEN(lineRecord.text$);",";(lineRecord.text$=expected$)
expected$ = FILL$("x",978) & "Z"
lineRecord.text$ = ""
PRINT #9,"plain-1000:";LEN(lineRecord.text$);",";(lineRecord.text$=expected$)
expected$ = FILL$("x",956) & "Z"
lineRecord.text$ = "" ## ignored at the end
PRINT #9,"hidden-1000:";LEN(lineRecord.text$);",";(lineRecord.text$=expected$)
expected$ = "## first ** literal ## last " & FILL$("x",950) & "Z"
lineRecord.text$ = "## first ** literal ## last "
PRINT #9,"quoted-markers-1000:";LEN(lineRecord.text$);",";(lineRecord.text$=expected$)
expected$ = "It's ## literal ** text " & FILL$("x",941) & "Z"
lineRecord.text$ = "It's ## literal ** text " ## invisible
PRINT #9,"mixed-double-1000:";LEN(lineRecord.text$);",";(lineRecord.text$=expected$)
expected$ = 'He said " ## literal ** text ' & FILL$("x",936) & "Z"
lineRecord.text$ = 'He said " ## literal ** text ' ## invisible
PRINT #9,"mixed-single-1000:";LEN(lineRecord.text$);",";(lineRecord.text$=expected$)
expected$ = FILL$("x",952) & "Z"
lineRecord.text$ = "" : ** a visible remark
PRINT #9,"visible-996:";LEN(lineRecord.text$);",";(lineRecord.text$=expected$)
expected$ = FILL$("x",845) & "Z"
                                                                                                                        lineRecord.text$ = "" ## invisible
PRINT #9,"indented-1000:";LEN(lineRecord.text$);",";(lineRecord.text$=expected$)
expected$ = FILL$("x",580) & " " & FILL$("x",397) & "Z"
lineRecord.text$ = "\+
"
PRINT #9,"continuation-1000:";LEN(lineRecord.text$);",";(lineRecord.text$=expected$)
CLOSE #9
OPEN_NEW #9,"win1_done":PRINT #9,"OK":CLOSE #9
STOP
