## ssbpass2_ssb
## Author: Timothy Swenson. (et al)
## Date Created: 16 Aug 2004.
## Date Revised: 20 Nov 2015.
## Date Revised: 09 Jan 2024.
## Date Revised: 28 Jul 2024.
## Date Revised: 13 Nov 2026.
## Version 2.8.0
##
## Pass_two does the main work of the filter.
##  It adds the line numbers and the goto references.
##
## This code was originally in the main ssb file,
## but was put in this file to make the code easier
## to read and to maintain.

## Public second pass. Use precisely the stream counted by pass_one.
## The driver owns output channel 4 and publishes only after this returns.
DEFine PROCedure pass_two(in_file$,file_num)
  rec_mapstart
  pass_two_file rec_source$,file_num
  rec_mapend
END DEFine pass_two

DEFine PROCedure pass_two_file (in_file$, file_num)

  LOCal in3$(100), a$(100), space$(1), rem$(2)
  LOCal comm$(2), at$(1), lab$(1), cont$(2)

  ## Temporary variables for scanning.
  rem$ = CHR$(42) & CHR$(42): ** REMark flag.
  comm$ = CHR$(35) & CHR$(35): ** Comment flag, ignore these lines.
  lab$ = CHR$(64): ** Label flag. 
  cont$ = "\+": ** Continuation flag, join this to the next line(s).

  ## No need for file checking since we've already
  ## opened the file before.
  OPEN_IN #file_num,in_file$
  REPeat pass_2
    num_count = num_count + 1
    IF (num_count MOD 10) = 0 THEN PRINT #3,CHR$(1);
    IF EOF(#file_num) THEN EXIT pass_2

    INPUT #file_num,in$
    rec_origin
    rec_range
    in$ = stripTab$(in$)  ## ND-272F.
    temp=first_char(in$)

    ## Ignore blank Lines
    IF temp=0 THEN
      IF d_ignore$ == "Y" THEN
        NEXT pass_2
      ELSE
        ## Convert blank lines to "line_no :" ND-272B.
        print #4, line_num; " :"           ## ND-272C.
        line_num = line_num + line_delta
          rec_range
        next pass_2
      END IF
    END IF

    ## Ignore Labels
    IF in$(1) = lab$ THEN NEXT pass_2: END IF
 
    ## Ignore ## comments
    IF in$(temp TO temp + 1) = comm$ THEN NEXT pass_2: END IF

    ## Ignore dot commands
    IF in$(temp) = "." THEN NEXT pass_2: END IF

######################################################

    ## A \ at the end of a line meaning to add the next line.
    ## ND: THIS IS BROKEN! 
    ## If there is a statement like "PRINT "Hello"\\ then we
    ## get the following line concatenated to the PRINT line. MISTake!
    ##
    ## ND-272F - extracted to separate function.
    ## ND-272G - amended to "\+" instead of "\" for PRINT separators.
    ##
    IF in$(LEN(in$)-1 TO) = "\+" THEN
      ** Join lines until we have the complete line.
      ** ready for further processing.
      in$ = joinLine$(in$)
    END IF

    ## Process ## comments.
    ## Separate function as of 272F.
    ## ND-272F.
    IF comm$ INSTR in$ THEN
      in$ = stripComment$(in$)
    END IF

    ## Process REMarks. Another separate function
    ## as of 272F.
    ## ND-272F.
    IF rem$ INSTR in$ THEN
      in$ = doRemark$(in$)
    END IF

######################################################

    ## Ignore #DEFINE commands since DEFINE table is already established
    IF upper$(in$(1 TO 7))="#DEFINE" THEN NEXT pass_2: END IF

    ## Look for #ENDIF when an #IFDEF has been defined
    IF LEN(in$) >= 6 THEN
      IF in$(1 TO 6) = "#ENDIF" THEN NEXT pass_2: END IF
    END IF

    ## Look for labels chr$(64) (The "at" sign.)
    temp = lab$ INSTR in$
    IF rc_enabled THEN temp=rec_labelref(in$)
    IF temp<>0 THEN
      a$ = in$(temp TO )
      temp2 = 0
      REPEAT loop2
        temp2 = temp2 + 1
        IF temp2 > d_labels THEN
          BEEP 1000,10
          INK #3,2
          ## FATAL ERROR - Label   Not Found
          PRINT #3,lngarray$(35);a$;lngarray$(32)
          ## LINE NUMBER:   IN FILE:
          PRINT #3,lngarray$(28);num_count;lngarray$(29);in_file$
          abort_out
        END IF
        IF label$(temp2) == a$ THEN EXIT loop2
      END REPEAT loop2
      PRINT #4,line_num;" ";in$(1 TO temp-1);label(temp2)
      line_num = line_num + line_delta
          rec_range
    ELSE
      ## Look for #INCLUDE
      IF upper$(in$(1 to 8))="#INCLUDE" THEN
        pass_two_file d_working$&in$(10 to), file_num+1
      ELSE
        ## Look for #IFDEF
        IF upper$(in$(1 TO 6))="#IFDEF" THEN
          temp = 0
          temp$ = upper$(in$(8 TO))
          FOR x = 1 TO define_var
            IF temp$ = defn$((x),1 TO LEN(temp$)) THEN temp = x
          END FOR X
          IF temp = 0 THEN
            REPEAT loop
              ## No need for EOF check since we would have
              ## caught it in pass_one.
              INPUT #file_num,in2$
              IF LEN(in2$) < 6 THEN NEXT loop
              IF upper$(in2$(1 TO 6))="#ENDIF" THEN EXIT loop
            END REPeat loop
          END IF
        ELSE
          PRINT #4,line_num;" ";in$
          line_num = line_num + line_delta
          rec_range
        END IF
      END IF
    END IF
  END REPeat pass_2
  CLOSE #file_num
END DEFine pass_two_file


## Shared planning/emission walk. Pass one calls this in both modes
## before counting labels, so its count includes every expanded line.
DEFine PROCedure rec_walk(emitting)
  LOCal text$(1000),rc_headerref$(1000),first
  ## Only the next routine needs pending REFERENCE text. Reset for each walk.
  rc_headerref$=""
  rc_emit=emitting: rc_type=0: rc_routine=0: rc_loop=0
  OPEN_IN #24,rc_work$(1): rc_open40=1
  REPeat rec_lower_stream
    IF EOF(#24) THEN EXIT rec_lower_stream
    INPUT #24,rc_file$: INPUT #24,rc_line: INPUT #24,text$
    ## Match declaration collection: only physical REFERENCE lines apply.
    first=first_char(text$)
    IF NOT rc_type AND first>0 THEN
      IF LEN(text$)-first>=8 THEN
        IF rec_upper$(text$(first TO first+8))="REFERENCE" THEN rec_pending_reference text$
      END IF
    END IF
    rc_temp=0: rec_statement text$
  END REPeat rec_lower_stream
  CLOSE #24: rc_open40=0
  rc_file$="generated pool helpers": rc_line=0: rec_pools
END DEFine rec_walk

DEFine PROCedure rec_pending_reference(text$)
  LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024),last
  rec_lex text$
  IF rec_upper$(rec_token$(1))<>"REFERENCE" THEN RETurn
  last=rk_n: IF rk_kind(last)=5 THEN last=last-1
  rc_headerref$=rec_join$(rc_headerref$,rec_part$(2,last))
END DEFine rec_pending_reference

## Quote-aware label lookup for expanded source.
DEFine FuNction rec_labelref(text$)
  LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024),i
  IF NOT (CHR$(64) INSTR text$) THEN RETurn 0
  rec_lex text$
  FOR i=1 TO rk_n
    IF rk_kind(i)=5 THEN RETurn 0
    IF rec_token$(i)=CHR$(64) THEN RETurn rk_s(i)
  END FOR i
  RETurn 0
END DEFine rec_labelref

## Record output: fields, storage, copies, calls and structured statements.
## Lower into the frozen unnumbered stream. rec_put is also used in planning.
DEFine FuNction rec_temp$
  rc_temp=rc_temp+1
  IF rc_temp>64 THEN rec_fail "Too many simultaneously required temporaries"
  IF rc_routine THEN
    IF rc_temp>rr_temps(rc_routine) THEN rr_temps(rc_routine)=rc_temp
  END IF
  RETurn "rec_t" & rec_num$(rc_temp)
END DEFine rec_temp$

DEFine PROCedure rec_put(text$)
  IF LEN(text$)>1000 THEN rec_fail "Expanded line exceeds SSB's 1000-byte input buffer"
  IF rc_emit THEN
    PRINT #25,text$
    PRINT #26,rc_file$: PRINT #26,rc_line
  END IF
END DEFine rec_put

## View results vw_* belong to caller. Does not evaluate selectors.
DEFine PROCedure rec_view(a,b)
  LOCal i,j,f,owner,path$(1024),rank,rs_b(64),rs_e(64),rs_n
  vw_var=rec_find(rec_token$(a),rv_name$,rv_n): vw_end=a-1: vw_leaf=0
  vw_sel$="": vw_prefix$="": vw_type=0: vw_rank=0
  IF NOT vw_var THEN RETurn
  vw_type=rv_type(vw_var): vw_rank=rv_rank(vw_var): i=a+1
  IF i<=b AND rec_token$(i)="(" THEN
    IF NOT vw_rank THEN rec_fail "A scalar record cannot be subscripted"
    j=rec_match(i,b): rec_split i+1,j-1
    IF rs_n<>vw_rank THEN rec_fail "Wrong record array rank: " & rv_name$(vw_var)
    vw_sel$=rec_part$(i+1,j-1): vw_rank=0: i=j+1
  END IF
  REPeat rec_fields
    IF i>b THEN EXIT rec_fields
    IF rec_token$(i)<>"." THEN EXIT rec_fields
    IF vw_rank THEN rec_fail "Subscript the record array before selecting a field"
    IF i+1>b THEN rec_fail "Missing field name"
    owner=vw_type: f=0
    FOR j=1 TO rf_n
      IF rf_owner(j)=owner AND rec_upper$(rf_name$(j))=rec_upper$(rec_token$(i+1)) THEN f=j
    END FOR j
    IF NOT f THEN rec_fail "Unknown field: " & rec_part$(a,i+1)
    i=i+2
    IF rf_type(f) THEN
      vw_type=rf_type(f): vw_prefix$=vw_prefix$ & rf_name$(f) & "_"
    ELSE
      path$=vw_prefix$ & rf_name$(f)
      FOR j=1 TO rl_n
        IF rl_owner(j)=rv_type(vw_var) AND rec_upper$(rl_path$(j))=rec_upper$(path$) THEN vw_leaf=j
      END FOR j
      IF NOT vw_leaf THEN rec_fail "Internal field layout error"
      IF i<=b AND rec_token$(i)="(" THEN
        j=rec_match(i,b)
        rec_split i+1,j-1
        rank=rl_rank(vw_leaf)
        IF rec_isstring(rf_name$(f)) THEN
          IF rs_n<>rank AND rs_n<>rank+1 THEN rec_fail "Wrong string field rank"
        ELSE
          IF rs_n<>rank THEN rec_fail "Wrong field array rank"
        END IF
        vw_sel$=rec_join$(vw_sel$,rec_part$(i+1,j-1)): i=j+1
      ELSE
        IF rl_rank(vw_leaf)>0 AND vw_sel$<>"" THEN rec_fail "Numeric subarray references are unsupported; select all field indices"
      END IF
      vw_type=0: EXIT rec_fields
    END IF
  END REPeat rec_fields
  vw_end=i-1
END DEFine rec_view

DEFine FuNction rec_leafname$(v,prefix$,leaf)
  RETurn rv_name$(v) & "_" & prefix$ & rl_path$(leaf)
END DEFine rec_leafname$

## Any nonconstant selector is saved, even a single variable.
DEFine FuNction rec_capture$(selectors$)
  LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
  LOCal rs_b(64),rs_e(64),rs_n,i,s$(1024),result$(1024),t$(1024)
  IF selectors$="" THEN RETurn ""
  rec_lex selectors$: rec_split 1,rk_n: result$=""
  FOR i=1 TO rs_n
    s$=rec_part$(rs_b(i),rs_e(i))
    IF isnum(s$) OR rec_find(s$,rm_name$,rm_n) THEN
      result$=rec_join$(result$,s$)
    ELSE
      t$=rec_temp$
      rec_put t$ & " = " & rec_expr$(s$)
      result$=rec_join$(result$,t$)
    END IF
  END FOR i
  RETurn result$
END DEFine rec_capture$

## Known ROM functions; arguments are still scanned for effects below.
DEFine FuNction rec_pure_builtin(name$)
  RETurn ("|" & name$ & "|") INSTR "|ABS|ACOS|ACOT|ASIN|ATAN|CHR$|CODE|COS|COT|DEG|DIMN|EXP|FILL$|INT|LEN|LN|LOG10|PI|RAD|SIN|SQRT|TAN|"
END DEFine rec_pure_builtin

## Conservative effect checker; array subscripts are not function calls.
DEFine FuNction rec_effect(text$,except$)
  LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
  LOCal i,j,s$(1024),known,builtin
  rec_lex text$
  FOR i=1 TO rk_n
    IF rk_kind(i)=1 THEN
      s$=rec_upper$(rec_token$(i))
      builtin=rec_pure_builtin(s$)
      IF s$<>rec_upper$(except$) THEN
        j=rec_find(s$,rr_name$,rr_n)
        IF j THEN
          IF rr_fun(j) THEN RETurn 1
        END IF
        IF i<rk_n AND rec_token$(i+1)="(" THEN
          IF NOT builtin THEN
            j=rec_find(s$,rn_name$,rn_n)
            IF NOT j THEN RETurn 1
            IF NOT rn_array(j) AND NOT rec_find(s$,rv_name$,rv_n) THEN RETurn 1
          END IF
        END IF
        IF s$="RND" OR s$="RND%" OR s$="DATE" OR s$="INKEY$" OR s$="KEYROW" THEN RETurn 1
        known=0
        j=rec_find(s$,rn_name$,rn_n)
        IF j THEN known=rn_ordinary(j) OR rn_array(j) OR rn_assignment(j)
        IF rec_find(s$,rv_name$,rv_n) OR rec_find(s$,rm_name$,rm_n) THEN known=1
        IF builtin THEN known=1
        IF s$="TO" OR s$="AND" OR s$="OR" OR s$="XOR" OR s$="NOT" OR s$="DIV" OR s$="MOD" OR s$="PI" THEN known=1
        IF i>1 THEN
          IF rec_token$(i-1)="." THEN known=1
        END IF
        IF NOT known THEN RETurn 1
      END IF
    END IF
  END FOR i
  RETurn 0
END DEFine rec_effect

DEFine FuNction rec_arguments$(routine,text$,expression)
  LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
  LOCal rs_b(64),rs_e(64),rs_n,i,j,p,v,n,sel$(1024),prefix$(160),result$(1024),actual$(1024),needs,effect,before
  LOCal vw_var,vw_type,vw_rank,vw_end,vw_leaf,vw_sel$(1024),vw_prefix$(160)
  rec_lex text$: rec_split 1,rk_n
  IF rs_n<>rr_count(routine) THEN rec_fail "Wrong argument count: " & rr_name$(routine)
  needs=0
  FOR i=1 TO rs_n
    p=rr_first(routine)+i-1
    IF ra_var(p) THEN
      rec_view rs_b(i),rs_e(i)
      IF NOT vw_var OR vw_leaf OR vw_end<>rs_e(i) THEN rec_fail "Record parameter requires declared record storage"
      v=ra_var(p)
      IF vw_type<>rv_type(v) OR vw_rank<>rv_rank(v) THEN rec_fail "Record parameter type/rank mismatch: " & ra_name$(p)
      IF vw_sel$<>"" THEN needs=1
    END IF
  END FOR i
  effect=rec_effect(text$,"")
  IF needs AND effect THEN
    IF expression OR rs_n<>1 THEN rec_fail "Split effectful record selectors/other arguments into explicit temporaries"
  END IF
  result$=""
  FOR i=1 TO rs_n
    p=rr_first(routine)+i-1: actual$=rec_part$(rs_b(i),rs_e(i))
    IF ra_var(p) THEN
      rec_view rs_b(i),rs_e(i)
      v=vw_var: n=vw_type: prefix$=vw_prefix$
      IF vw_sel$<>"" THEN
        FOR j=1 TO rl_n
          IF rl_owner(j)=n AND rl_rank(j)>0 THEN rec_fail "Cannot pass a record array element containing array fields; use a standalone work record and copy"
        END FOR j
        IF rc_profile$="TURBO509" THEN rec_fail "Turbo cannot pass record array elements by reference; use a standalone work record and copy, or SSBRECPROFILE=SBASIC for interpreted output"
      END IF
      sel$=rec_capture$(vw_sel$)
      FOR j=1 TO rl_n
        IF rl_owner(j)=n THEN
          actual$=rec_leafname$(v,prefix$,j)
          IF sel$<>"" THEN actual$=actual$ & "(" & sel$ & ")"
          result$=rec_join$(result$,actual$)
        END IF
      END FOR j
    ELSE
      before=rc_temp
      actual$=rec_expr$(actual$)
      IF rc_temp<>before AND i>1 THEN
        IF rec_effect(rec_part$(1,rs_b(i)-2),"") THEN rec_fail "Split earlier effectful arguments before a captured record selector"
      END IF
      IF ra_val(p) THEN actual$="(" & actual$ & ")"
      result$=rec_join$(result$,actual$)
    END IF
  END FOR i
  RETurn result$
END DEFine rec_arguments$

DEFine FuNction rec_expr$(text$)
  LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
  LOCal i,j,v,pos,result$(1024),s$(1024),before
  LOCal vw_var,vw_type,vw_rank,vw_end,vw_leaf,vw_sel$(1024),vw_prefix$(160)
  rec_lex text$: i=1: pos=1: result$=""
  REPeat rec_expression
    IF i>rk_n THEN EXIT rec_expression
    IF rk_kind(i)=5 THEN EXIT rec_expression
    s$="": j=i
    IF rec_token$(i)="." THEN
      IF i=rk_n THEN rec_fail "Field selection from a function result is unsupported"
      IF rk_kind(i+1)<>2 THEN rec_fail "Field selection requires a declared record"
    END IF
    IF rk_kind(i)=1 THEN
      v=rec_find(rec_token$(i),rr_name$,rr_n)
      IF v AND i<rk_n AND rec_token$(i+1)="(" THEN
        IF NOT rr_fun(v) THEN rec_fail "A procedure call is not an expression"
        j=rec_match(i+1,rk_n): before=rc_temp
        s$=rec_token$(i) & "(" & rec_arguments$(v,rec_part$(i+2,j-1),1) & ")"
        IF rc_temp<>before AND (i<>1 OR j<>rk_n) THEN rec_fail "Split a record argument selector out of the surrounding expression"
      ELSE
        rec_view i,rk_n
        IF vw_var THEN
          IF NOT vw_leaf THEN rec_fail "Whole records are only valid in copies and record parameters"
          before=rc_temp
          s$=rec_access$(vw_var,vw_leaf,rec_expr$(vw_sel$)): j=vw_end
          IF rc_temp<>before THEN rec_fail "Split captured record arguments out of field subscripts"
        ELSE
          IF i<rk_n AND rec_token$(i+1)="." THEN rec_fail "Unknown record: " & rec_token$(i)
        END IF
      END IF
    END IF
    IF s$<>"" THEN
      IF rk_s(i)>pos THEN result$=result$ & text$(pos TO rk_s(i)-1)
      result$=result$ & s$: pos=rk_e(j)+1: i=j
    END IF
    i=i+1
  END REPeat rec_expression
  IF pos<=LEN(text$) THEN result$=result$ & text$(pos TO)
  RETurn result$
END DEFine rec_expr$

DEFine FuNction rec_loops$(shape$)
  LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
  LOCal rs_b(64),rs_e(64),rs_n,i,t$(1024),indices$(1024)
  indices$=""
  rec_lex shape$: rec_split 1,rk_n
  FOR i=1 TO rs_n
    t$=rec_temp$: rec_put "FOR " & t$ & " = 0 TO " & rec_part$(rs_b(i),rs_e(i))
    indices$=rec_join$(indices$,t$)
    rc_loop=rc_loop+1: rc_loop$(rc_loop)=t$
  END FOR i
  RETurn indices$
END DEFine rec_loops$

DEFine PROCedure rec_endloops(old)
  REPeat rec_close_loops
    IF rc_loop<=old THEN EXIT rec_close_loops
    rec_put "END FOR " & rc_loop$(rc_loop): rc_loop=rc_loop-1
  END REPeat rec_close_loops
END DEFine rec_endloops

DEFine PROCedure rec_copy(left$,right$)
  LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
  LOCal vw_var,vw_type,vw_rank,vw_end,vw_leaf,vw_sel$(1024),vw_prefix$(160)
  LOCal dv,sv,typeid,dp$(160),sp$(160),ds$(1024),ss$(1024),di$(1024),si$(1024),shape$(120),j,old
  rec_lex left$: rec_view 1,rk_n
  IF NOT vw_var OR vw_leaf OR vw_end<>rk_n OR vw_rank THEN rec_fail "Copy destination must be one record"
  dv=vw_var: typeid=vw_type: dp$=vw_prefix$: ds$=vw_sel$
  rec_lex right$: rec_view 1,rk_n
  IF NOT vw_var OR vw_leaf OR vw_end<>rk_n OR vw_rank THEN rec_fail "Functions cannot return records; use an output record procedure"
  IF vw_type<>typeid THEN rec_fail "Record copy requires the same nominal TYPE"
  sv=vw_var: sp$=vw_prefix$: ss$=vw_sel$
  IF rec_effect(ds$,"") AND rec_effect(ss$,"") THEN rec_fail "Split effectful copy selectors into explicit temporaries"
  ds$=rec_capture$(ds$): ss$=rec_capture$(ss$)
  FOR j=1 TO rl_n
    IF rl_owner(j)=typeid THEN
      shape$=rec_logicalshape$(j): di$="": old=rc_loop
      di$=rec_loops$(shape$)
      si$=rec_join$(ss$,di$): di$=rec_join$(ds$,di$)
      rec_put rec_selected$(dv,dp$,j,di$) & " = " & rec_selected$(sv,sp$,j,si$)
      rec_endloops old
    END IF
  END FOR j
END DEFine rec_copy

DEFine FuNction rec_selected$(v,prefix$,leaf,indices$)
  LOCal s$(1024)
  s$=rec_leafname$(v,prefix$,leaf)
  IF indices$<>"" THEN s$=s$ & "(" & indices$ & ")"
  RETurn s$
END DEFine rec_selected$

DEFine FuNction rec_logicalshape$(leaf)
  LOCal i,s$(1024)
  s$=rl_shape$(leaf)
  IF rec_isstring(rl_path$(leaf)) THEN
    i=LEN(s$)
    REPeat rec_last_axis
      IF i=0 THEN RETurn ""
      IF s$(i)="," THEN RETurn s$(TO i-1)
      i=i-1
    END REPeat rec_last_axis
  END IF
  RETurn s$
END DEFine rec_logicalshape$

DEFine FuNction rec_isstring(s$)
  RETurn s$(LEN(s$))="$"
END DEFine rec_isstring

DEFine PROCedure rec_storage(v,shape$,pool)
  LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
  LOCal rs_b(64),rs_e(64),rs_n,i,j,s$(1024),t$(64),bounds$(1024),indices$(1024),old,value$(1024)
  bounds$=""
  rec_lex shape$: rec_split 1,rk_n
  FOR i=1 TO rs_n
    t$=rec_temp$: s$=rec_part$(rs_b(i),rs_e(i))
    IF rec_effect(shape$,"") AND rs_n>1 THEN rec_fail "Split effectful dimensions into explicit temporaries"
    rec_put t$ & " = " & rec_expr$(s$)
    rec_put "IF " & t$ & " < " & rec_num$(pool) & " OR " & t$ & " > 32767 OR " & t$ & " <> INT(" & t$ & ') THEN PRINT "Invalid record bound: ' & rv_name$(v) & '": STOP'
    bounds$=rec_join$(bounds$,t$)
  END FOR i
  FOR j=1 TO rl_n
    IF rl_owner(j)=rv_type(v) THEN
      s$=rec_join$(bounds$,rl_shape$(j))
      IF s$<>"" THEN rec_put "DIM " & rec_name$(v,j) & "(" & s$ & ")"
      indices$="": old=rc_loop
      indices$=rec_loops$(rec_join$(bounds$,rec_logicalshape$(j)))
      value$="0": IF rec_isstring(rl_path$(j)) THEN value$='""'
      rec_put rec_access$(v,j,indices$) & " = " & value$
      rec_endloops old
    END IF
  END FOR j
  IF pool THEN rec_poolinit v,bounds$
END DEFine rec_storage

DEFine PROCedure rec_header(routine)
  LOCal p,v,j,i,count,s$(1024),ref$(1024),name$(320),localcount
  s$="": ref$="": count=0
  localcount=rr_simplelocals(routine)+rr_temps(routine)
  FOR p=rr_first(routine) TO rr_first(routine)+rr_count(routine)-1
    v=ra_var(p)
    IF v THEN
      FOR j=1 TO rl_n
        IF rl_owner(j)=rv_type(v) THEN
          name$=rec_name$(v,j): s$=rec_join$(s$,name$): count=count+1
          name$=name$ & rec_refdims$(v,j)
          ref$=rec_join$(ref$,name$)
        END IF
      END FOR j
    ELSE
      s$=rec_join$(s$,ra_name$(p)): count=count+1
    END IF
  END FOR p
  IF count>rc_maxparams THEN rec_fail "Expanded parameter count exceeds profile"
  IF rc_headerref$<>"" THEN rec_reference "REFERENCE " & rc_headerref$
  rc_headerref$=""
  IF ref$<>"" THEN rec_put "REFERENCE " & ref$
  name$="PROCedure ": IF rr_fun(routine) THEN name$="FuNction "
  IF s$<>"" THEN s$="(" & s$ & ")"
  rec_put "DEFine " & name$ & rr_name$(routine) & s$
  FOR i=1 TO rr_temps(routine)
    rec_put "LOCal rec_t" & rec_num$(i)
  END FOR i
  FOR i=1 TO rc_locals
    IF rc_lr(i)=routine THEN
      v=rc_lv(i)
      FOR j=1 TO rl_n
        IF rl_owner(j)=rv_type(v) THEN
          name$=rec_name$(v,j)
          count=rv_rank(v)+rl_rank(j)
          IF count OR rec_isstring(rl_path$(j)) THEN
            IF rec_isstring(rl_path$(j)) THEN
              name$=name$ & "(" & rec_join$(rec_zeros$(count),"1") & ")"
            ELSE
              name$=name$ & rec_dims$(count)
            END IF
          END IF
          localcount=localcount+1
          rec_put "LOCal " & name$
        END IF
      END FOR j
    END IF
  END FOR i
  IF localcount>64 THEN rec_fail "Expanded local count exceeds profile (64)"
END DEFine rec_header

DEFine FuNction rec_zeros$(rank)
  LOCal i,result$(1024)
  result$=""
  FOR i=1 TO rank
    result$=rec_join$(result$,"0")
  END FOR i
  RETurn result$
END DEFine rec_zeros$

## A string array has a final character-capacity dimension in Turbo.
## A simple bounded string is the special scalar-string reference case.
DEFine FuNction rec_refdims$(variable,leaf)
  LOCal rank
  rank=rv_rank(variable)+rl_rank(leaf)
  IF rank AND rec_isstring(rl_path$(leaf)) THEN rank=rank+1
  RETurn rec_dims$(rank)
END DEFine rec_refdims$

## Structured statement boundary handling precedes expression rewriting.
DEFine PROCedure rec_statement(text$)
  LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
  LOCal rs_b(64),rs_e(64),rs_n,i,j,k,b,depth,cut,thenat,elseat,endat,kind$(64),s$(1024),v,before
  LOCal rd_name$(64),rd_shape$(1024),rd_rank,rd_type,rd_val,rd_pool
  LOCal vw_var,vw_type,vw_rank,vw_end,vw_leaf,vw_sel$(1024),vw_prefix$(160)
  LOCal remaining$(1000)
  remaining$=text$
@rcstmt
  rec_lex remaining$
  IF rk_n=0 THEN
    IF d_ignore$<>"Y" THEN rec_put ":"
    RETurn
  END IF
  kind$=rec_upper$(rec_token$(1)): b=rk_n
  IF kind$=CHR$(64) THEN rec_put remaining$: RETurn
  IF kind$="TYPE" THEN rc_type=1: RETurn
  IF kind$="END" AND rec_upper$(rec_token$(2))="TYPE" THEN rc_type=0: RETurn
  IF rc_type THEN RETurn
  IF rk_kind(1)=5 THEN
    IF kind$="DATA" THEN rec_data remaining$
    rec_put remaining$: RETurn
  END IF
  IF rk_kind(b)=5 THEN b=b-1
  IF b=0 THEN rec_put remaining$: RETurn
  IF kind$="DEFINE" OR kind$="DEF" THEN
    rc_routine=rec_find(rec_token$(3),rr_name$,rr_n): rec_header rc_routine: RETurn
  END IF
  IF kind$="END" AND (rec_upper$(rec_token$(2))="DEFINE" OR rec_upper$(rec_token$(2))="DEF") THEN
    rec_put remaining$: rc_routine=0: RETurn
  END IF
  IF kind$="REFERENCE" THEN RETurn
  IF kind$="IF" THEN
    depth=0: thenat=0: elseat=0: endat=0
    FOR i=2 TO b
      IF rec_token$(i)="(" THEN depth=depth+1
      IF rec_token$(i)=")" THEN depth=depth-1
      IF depth=0 THEN
        IF rec_upper$(rec_token$(i))="THEN" AND NOT thenat THEN thenat=i
        IF thenat AND rec_upper$(rec_token$(i))="IF" THEN
          IF rec_upper$(rec_token$(i-1))<>"END" THEN rec_fail "Use multiline form for nested inline IF"
        END IF
        IF rec_upper$(rec_token$(i))="ELSE" THEN
          IF elseat THEN rec_fail "Use multiline form for nested inline IF"
          elseat=i
        END IF
        IF rec_upper$(rec_token$(i))="END" AND i<b THEN
          IF rec_upper$(rec_token$(i+1))="IF" THEN endat=i
        END IF
      END IF
    END FOR i
    IF NOT thenat THEN rec_fail "Record profile requires THEN in IF statements"
    IF thenat=b-1 AND rec_token$(b)=":" THEN rec_fail "Put THEN last on a multiline IF header"
    rec_put "IF " & rec_expr$(rec_part$(2,thenat-1)) & " THEN"
    IF thenat=b THEN RETurn
    j=b: IF endat THEN j=endat-1
    IF elseat THEN
      rec_statement rec_part$(thenat+1,elseat-1): rec_put "ELSE"
      rec_statement rec_part$(elseat+1,j)
    ELSE
      rec_statement rec_part$(thenat+1,j)
    END IF
    rec_put "END IF": RETurn
  END IF
  depth=0: cut=0
  FOR i=1 TO b
    IF rec_token$(i)="(" THEN depth=depth+1
    IF rec_token$(i)=")" THEN depth=depth-1
    IF rec_token$(i)=":" AND depth=0 THEN cut=i: EXIT i
  END FOR i
  IF cut THEN
    IF kind$="=" THEN
      before=rc_temp: s$=rec_expr$(rec_part$(1,cut-1))
      IF rc_temp<>before THEN rec_fail "Split record argument captures out of SELECT case values"
      rec_put s$ & ":": remaining$=rec_part$(cut+1,rk_n): GO TO @rcstmt
    END IF
    IF kind$="FOR" OR kind$="REPEAT" OR kind$="REP" THEN
      FOR j=cut+1 TO b-1
        IF rec_upper$(rec_token$(j))="END" THEN
          IF rec_upper$(rec_token$(j+1))=kind$ THEN rec_fail "Use multiline form for explicitly closed inline loops"
        END IF
      END FOR j
      rec_statement rec_part$(1,cut-1)
      rec_statement rec_part$(cut+1,rk_n)
      rec_put "END " & rec_token$(1) & " " & rec_expr$(rec_token$(2)): RETurn
    END IF
    IF cut>1 THEN rec_statement rec_part$(1,cut-1)
    ## Iterate over the rest instead of keeping a parser frame per colon.
    IF cut<rk_n THEN remaining$=rec_part$(cut+1,rk_n): GO TO @rcstmt
    RETurn
  END IF
  IF kind$="DIM" OR kind$="LOCAL" THEN
    rec_split 2,b
    FOR i=1 TO rs_n
      k=0
      FOR j=rs_b(i) TO rs_e(i)
        IF rec_upper$(rec_token$(j))="AS" THEN k=1
      END FOR j
      IF k THEN
        rec_descriptor rs_b(i),rs_e(i),0
        v=rec_find(rd_name$,rv_name$,rv_n)
        rec_storage v,rd_shape$,rd_pool
      ELSE
        s$=rec_part$(rs_b(i),rs_e(i))
        IF rec_find(rec_token$(rs_b(i)),rv_name$,rv_n) THEN rec_fail "Cannot independently dimension record storage"
        rec_put rec_token$(1) & " " & rec_expr$(s$)
      END IF
    END FOR i
    RETurn
  END IF
  rec_view 1,b
  IF vw_var AND NOT vw_leaf THEN
    i=vw_end+1
    IF i>b OR rec_token$(i)<>"=" THEN rec_fail "Whole record requires an assignment or typed parameter"
    rec_copy rec_part$(1,vw_end),rec_part$(i+1,b): RETurn
  END IF
  v=rec_find(rec_token$(1),rr_name$,rr_n)
  IF v AND NOT rr_fun(v) THEN
    i=2: j=b
    IF i<=b AND rec_token$(i)="(" THEN j=rec_match(i,b)-1: i=i+1
    s$=rec_arguments$(v,rec_part$(i,j),0)
    IF s$<>"" THEN s$=" " & s$
    rec_put rec_token$(1) & s$: RETurn
  END IF
  IF kind$="FOR" THEN
    rec_view 2,b
    IF vw_var AND (NOT vw_leaf OR vw_sel$<>"") THEN rec_fail "FOR counter must be a simple scalar field"
    IF vw_leaf THEN
      IF rl_rank(vw_leaf)<>0 OR rec_isstring(rl_path$(vw_leaf)) THEN rec_fail "FOR counter must be a numeric scalar field"
    END IF
  END IF
  IF kind$="PRINT" OR kind$="RETURN" OR kind$="RET" THEN
    before=rc_temp: s$=rec_expr$(rec_part$(2,rk_n))
    rec_put rec_token$(1) & " " & s$: RETurn
  END IF
  IF b>2 AND rk_kind(1)=1 AND rec_token$(2)="=" THEN
    rec_put rec_token$(1) & " = " & rec_expr$(rec_part$(3,rk_n)): RETurn
  END IF
  rec_put rec_expr$(remaining$)
END DEFine rec_statement

DEFine PROCedure rec_data(text$)
  LOCal i,q$(1024),c$(1024)
  q$=""
  FOR i=1 TO LEN(text$)
    c$=text$(i)
    IF q$<>"" THEN
      IF c$=q$ THEN q$=""
    ELSE
      IF c$='"' OR c$="'" THEN
        q$=c$
      ELSE
        IF c$=":" THEN rec_fail "Put DATA on a separate line; quote colons in DATA strings"
      END IF
    END IF
  END FOR i
END DEFine rec_data

DEFine PROCedure rec_reference(text$)
  LOCal rk_len%(258),rk_s(258),rk_e(258),rk_kind(258),rk_n,rk_line$(1024)
  LOCal rs_b(64),rs_e(64),rs_n,i,j,p,v,s$(1024),entry$(160)
  rec_lex text$: rec_split 2,rk_n: s$=""
  FOR i=1 TO rs_n
    entry$=rec_token$(rs_b(i))
    FOR p=rr_first(rc_routine) TO rr_first(rc_routine)+rr_count(rc_routine)-1
      IF rec_upper$(ra_name$(p))=rec_upper$(entry$) AND ra_val(p) THEN rec_fail "REFERENCE conflicts with VAL: " & entry$
    END FOR p
    v=rec_find(entry$,rv_name$,rv_n)
    IF v THEN
      FOR j=1 TO rl_n
        IF rl_owner(j)=rv_type(v) THEN s$=rec_join$(s$,rec_name$(v,j) & rec_refdims$(v,j))
      END FOR j
    ELSE
      s$=rec_join$(s$,rec_part$(rs_b(i),rs_e(i)))
    END IF
  END FOR i
  rec_put "REFERENCE " & s$
END DEFine rec_reference

## Generated pool allocation and release routines.
## Optional fixed-capacity integer-handle pools; no external record runtime.
DEFine PROCedure rec_poolinit(v,bound$)
  LOCal s$(1024),t$(1024)
  s$="rec_p" & rec_num$(v): t$=rec_temp$
  rec_put s$ & "_size = " & bound$
  rec_put "DIM " & s$ & "_next%(" & bound$ & ")"
  rec_put "FOR " & t$ & " = 1 TO " & bound$ & " - 1"
  rec_put s$ & "_next%(" & t$ & ") = " & t$ & " + 1"
  rec_put "END FOR " & t$
  rec_put s$ & "_next%(" & bound$ & ") = 0"
  rec_put s$ & "_head% = 1"
END DEFine rec_poolinit

DEFine PROCedure rec_pools
  LOCal v,j,s$(1024),name$(1024),indices$(1000),old,value$(1024),shape$(1024)
  FOR v=1 TO rv_n
    IF rv_pool(v) THEN
      s$="rec_p" & rec_num$(v): name$=rv_name$(v)
      rec_put "DEFine FuNction " & name$ & "_new%"
      rec_put "LOCal rec_slot%,rec_t1,rec_t2,rec_t3,rec_t4,rec_t5,rec_t6,rec_t7,rec_t8"
      rec_put "rec_slot% = " & s$ & "_head%"
      rec_put 'IF rec_slot% = 0 THEN PRINT "Pool exhausted: ' & name$ & '": STOP'
      rec_put s$ & "_head% = " & s$ & "_next%(rec_slot%)"
      rec_put s$ & "_next%(rec_slot%) = -1"
      FOR j=1 TO rl_n
        IF rl_owner(j)=rv_type(v) THEN
          indices$="": old=rc_loop: rc_temp=0
          indices$=rec_loops$(rec_logicalshape$(j))
          indices$=rec_join$("rec_slot%",indices$)
          value$="0": IF rec_isstring(rl_path$(j)) THEN value$='""'
          rec_put rec_access$(v,j,indices$) & " = " & value$
          rec_endloops old
        END IF
      END FOR j
      rec_put "RETurn rec_slot%": rec_put "END DEFine"
      rec_put "DEFine PROCedure " & name$ & "_free(rec_handle)"
      ## This helper is already lowered. VAL is represented by a caller-safe
      ## scalar input: no writes to rec_handle, and no output before validation.
      rec_put "IF rec_handle = 0 THEN RETurn"
      rec_put "IF rec_handle < 1 OR rec_handle > " & s$ & '_size OR rec_handle <> INT(rec_handle) THEN PRINT "Invalid pool handle: ' & name$ & '": STOP'
      rec_put "IF " & s$ & '_next%(rec_handle) <> -1 THEN PRINT "Double free: ' & name$ & '": STOP'
      rec_put s$ & "_next%(rec_handle) = " & s$ & "_head%"
      rec_put s$ & "_head% = rec_handle": rec_put "END DEFine"
    END IF
  END FOR v
END DEFine rec_pools
