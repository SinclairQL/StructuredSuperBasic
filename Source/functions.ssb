## A function to trim leading and trailing spaces from a string.
DEFine FuNction Trim$(text$)
    IF text$ <> "" THEN
        RETurn RTrim$(LTrim$(text$))
    ELSE
        RETurn ""
    END IF
## Fix inherited from 2.7.2g: close Trim$ with its own name.
END DEFine Trim$
:
:
## A function to trim leading spaces from a string.
DEFine FuNction LTrim$(text$)
    ## Fix inherited from 2.7.2g: retain up to a complete 1000-byte source line.
    LOCal x, ret$(1000)
    :
    ## Empty strings are easy!
    IF text$ = "" THEN RETurn "": END IF
    :
    ## Check for leading spaces.
    FOR x = 1 to LEN(text$)
        if text$(x) <> " " THEN EXIT x: END IF
    END FOR x
    ret$ = text$(x TO)
    ## If the result is a single space, we had a
    ## string that is all spaces.
    if ret$ = " " then ret$ = "": end if
    return ret$
END DEFine LTrim$
:
:
## A function to trim trailing spaces from a string.
DEFine FuNction RTrim$(text$)
    ## Fix inherited from 2.7.2g: retain up to a complete 1000-byte source line.
    LOCal x, ret$(1000)
    :
    ## Empty strings are easy!
    IF text$ = "" THEN RETurn "": END IF
    :
    ## Check for trailing spaces.
    FOR x = LEN(text$) TO 1 STEP -1
        if text$(x) <> " " THEN EXIT x: END IF
    END FOR x
    ret$ = text$(TO x)
    ## If the result is a single space, we had a
    ## string that was all spaces.
    if ret$ = " " then ret$ = "": end if
    return ret$
END DEFine RTrim$

## ND-272e
## A procedure to centre some text in a 300 pixel wide
## window. Characters are assumed to be 6 pixels wide as
## testing showed that this worked. The border is 2 pixels
## wide also, this has to be doubled.
DEFine PROCedure centre(ch, text$)
    LOCal size, winSize
    :
    winSize = (300-2-2)/6
    size = len(text$)
    print #ch, to (winSize-size)/2; text$
END DEF centre
:
:
## Function inString%
##   ND-272c
##   A function to determine if we found
##   a REMark or invisible REMark characters
##   within a string. We don't want to be
##   messing up the user's data!
##
##   ND-272F
##   Modified to return the closing quote index
##   if in a string, or zero if not.

DEFine FuNction inString% (in$, stopHere)
  LOCal x,quote$(1)
  ## Fix inherited from 2.7.2g: only the active delimiter closes a string.
  ## The other quote character is literal content, not a second opener.
  quote$ = ""
  FOR x = 1 TO stopHere
    IF quote$ <> "" THEN
      IF in$(x) = quote$ THEN quote$ = ""
    ELSE
      IF in$(x) = '"' OR in$(x) = "'" THEN quote$ = in$(x)
    END IF
  END FOR x
  IF quote$ = "" THEN RETurn 0
  FOR x = stopHere + 1 TO LEN(in$)
    IF in$(x) = quote$ THEN RETurn x
  END FOR x
  ## An unmatched quote must not fall through without a function result.
  RETurn 0
END DEFine inString%


## Function stripTab$
##   Replaces any hard tab characters in the line
##   with a single space. Hard tabs (CHR$(9) cause
##   non-REMark lines to "MISTake" on loading.
##   ND-272F.
DEFine FuNction stripTab$ (a$)
  LOCal x, loop

  IF a$ = "" THEN return a$: END IF
  REPeat loop
    x = CHR$(9) INSTR a$
    IF x = 0 THEN EXIT loop: END IF
    IF x = 1 THEN
       ** SMSQ Bug workaround. See ssbpass2_ssb for details.
       a$ = " " & a$(2 TO)
       NEXT loop
    END IF

    a$ = a$(TO x-1) & " " & a$(x + 1 TO)
  END REPeat loop

  RETurn a$
END DEFine stripTab$


## Function joinLine$
##   When a line continuation flag is found at the end
##   of a line, we come here to join as many continuation
##   lines as necessary. The completely joined line is
##   returned for further processing.
##   ND-272F.
DEFine FuNction joinLine$(a$)
  LOCal in$(2048),out$(2048), joinLoop, temp
  :
  out$ = a$ ## Entire line, including "\".
  REPeat joinloop
    IF NOT out$(LEN(out$)-1 TO) = "\+" THEN EXIT joinLoop: END IF

    ## No need for EOF check because we would have
    ## caught it in pass_one.
    INPUT #file_num,in$
    temp = first_char(in$)
    out$ = rtrim$(out$(TO (LEN(out$)-2))) & " " & in$(temp TO)
  END REPeat joinloop

  RETurn out$
END DEFine joinLine$

## Function stripComment$
##   Strips invisible comments from a line, but
##   not if they appear in a string. Everything after
##   the first ## is stripped off.
##   ND-272F.
DEFine FuNction stripComment$(a$)
  ## Fix inherited from 2.7.2g: Turbo's default 100-byte locals lose long lines.
  LOCal in$(1000), out$(1000), stripLoop, temp, whereQuote
  :
  in$ = a$
  out$ = ""  

  ** Quick test for start of line.
  IF comm$ INSTR in$ = 1 THEN 
    RETURN out$
  END IF

  REPeat stripLoop
    temp = comm$ INSTR in$
    IF temp = 0 THEN
      out$ = out$ & in$
      EXIT stripLoop
    END IF

    ** If not in a string, strip to the end.
    whereQuote = inString%(in$, temp)
    IF NOT whereQuote THEN
      out$ = out$ & in$(1 TO temp - 1)
      EXIT stripLoop
    END IF

    ** Must be in a string, so extend out$ and try again.
    ## Fix inherited from 2.7.2g: retain earlier quoted comment markers.
    out$ = out$ & in$(1 to whereQuote)
    in$ = in$(whereQuote + 1 TO)
  END REPeat stripLoop

  RETurn out$
END DEFine stripComment$

## Function doRemark$
##   Convert a double asterisk, which is not in a string, 
##   into a REMark. 
##   ND-272F.
DEFine FuNction doRemark$(a$)
  LOCal in$(2048), out$(2048), remarkLoop, temp
  :
  in$ = a$
  out$ = ""

  ** Quick test for start of line.
  IF rem$ INSTR in$ = 1 THEN 
    RETURN "REMark" & in$(3 TO)
  END IF

  REPeat remarkLoop
    temp = rem$ INSTR in$

    ## No more? We are done.
    IF temp = 0 THEN
      out$ = out$ & in$
      EXIT remarkLoop
    END IF
      
    ** If not in a string, replace it & exit as 
    ** anything after it is part of the REMark.
    whereQuote = inString%(in$, temp)
    IF NOT whereQuote THEN
      out$ = out$ & in$(TO temp - 1) & "REMark" & in$(temp + 2 TO)
      EXIT remarkLoop
    END IF

    ** Must be in a string, so extend out$ and try again.
    out$ = out$ & in$(1 to whereQuote)
    in$ = in$(whereQuote + 1 TO)
  END REPeat remarkLoop

  RETurn out$
END DEFine doRemark$

## Shared record lexical, name, dimension and source-slice helpers.
## Record extension: byte-preserving lexical utilities. ASCII syntax only.
## rk_* token spans belong to the caller (QL dynamic scope).
## Keep text only in rk_line$: a 258 by 160 string matrix costs over 40 KiB
## at every recursive parsing level. Token lengths need only 16-bit integers.
DEFine PROCedure rec_lex(text$)
  LOCal i,j,c$(160),q$(1),depth
  rk_line$=text$: rk_n=0: i=1
  REPeat rec_scan
    IF i>LEN(text$) THEN EXIT rec_scan
    c$=text$(i)
    IF c$=" " OR c$=CHR$(9) THEN i=i+1: NEXT rec_scan
    IF rk_n=256 THEN rec_fail "Too many tokens on one line"
    rk_n=rk_n+1: rk_s(rk_n)=i: rk_kind(rk_n)=4
    j=i
    IF c$='"' OR c$="'" THEN
      rk_kind(rk_n)=3: q$=c$: j=i+1
      REPeat rec_quote
        IF j>LEN(text$) THEN rec_fail "Unterminated quoted string"
        IF text$(j)=q$ THEN EXIT rec_quote
        j=j+1
      END REPeat rec_quote
    ELSE
      IF rec_letter(c$) THEN
        rk_kind(rk_n)=1
        REPeat rec_ident
          IF j=LEN(text$) THEN EXIT rec_ident
          IF NOT rec_namechar(text$(j+1)) THEN EXIT rec_ident
          j=j+1
        END REPeat rec_ident
        IF j<LEN(text$) THEN
          IF text$(j+1)="$" OR text$(j+1)="%" THEN j=j+1
        END IF
      ELSE
        IF rec_digit(c$) OR c$="$" OR c$="%" THEN
          rk_kind(rk_n)=2
          REPeat rec_number
            IF j=LEN(text$) THEN EXIT rec_number
            c$=rec_upper$(text$(j+1))
            IF NOT rec_namechar(c$) AND c$<>"." THEN EXIT rec_number
            j=j+1
            IF c$="E" AND j<LEN(text$) THEN
              IF text$(j+1)="+" OR text$(j+1)="-" THEN j=j+1
            END IF
          END REPeat rec_number
        END IF
      END IF
    END IF
    rk_e(rk_n)=j
    IF rk_kind(rk_n)=3 THEN
      rk_len%(rk_n)=1
    ELSE
      IF j-i>159 THEN rec_fail "Identifier/number token exceeds 160 bytes"
      rk_len%(rk_n)=j-i+1
    END IF
    c$=rec_upper$(rec_token$(rk_n))
    IF c$="REMARK" OR c$="REM" OR c$="DATA" THEN
      rk_e(rk_n)=LEN(text$): rk_len%(rk_n)=LEN(c$): rk_kind(rk_n)=5
      EXIT rec_scan
    END IF
    IF j<LEN(text$) THEN
      c$=text$(j TO j+1)
      IF c$="##" OR c$="**" THEN
        rk_e(rk_n)=LEN(text$): rk_len%(rk_n)=LEN(c$): rk_kind(rk_n)=5
        EXIT rec_scan
      END IF
    END IF
    i=j+1
  END REPeat rec_scan
END DEFine rec_lex


## Match the old token representation: strings expose their opening quote;
## REMark/DATA/comment tokens expose only their marker, in upper case.
DEFine FuNction rec_token$(tokenIndex)
  LOCal first,last
  IF tokenIndex<1 OR tokenIndex>rk_n THEN RETurn ""
  first=rk_s(tokenIndex): last=first+rk_len%(tokenIndex)-1
  IF rk_kind(tokenIndex)=5 THEN RETurn rec_upper$(rk_line$(first TO last))
  RETurn rk_line$(first TO last)
END DEFine rec_token$

DEFine FuNction rec_letter(c$)
  LOCal k
  IF c$="" THEN RETurn 0
  k=CODE(rec_upper$(c$))
  RETurn k>=65 AND k<=90
END DEFine rec_letter

DEFine FuNction rec_digit(c$)
  IF c$="" THEN RETurn 0
  RETurn CODE(c$)>=48 AND CODE(c$)<=57
END DEFine rec_digit

DEFine FuNction rec_namechar(c$)
  RETurn rec_letter(c$) OR rec_digit(c$) OR c$="_"
END DEFine rec_namechar

DEFine FuNction rec_part$(a,b)
  IF b<a THEN RETurn ""
  RETurn rk_line$(rk_s(a) TO rk_e(b))
END DEFine rec_part$

DEFine FuNction rec_match(a,last)
  LOCal i,depth
  depth=0
  FOR i=a TO last
    IF rec_token$(i)="(" THEN depth=depth+1
    IF rec_token$(i)=")" THEN
      depth=depth-1
      IF depth=0 THEN RETurn i
    END IF
  END FOR i
  rec_fail "Unbalanced parentheses"
END DEFine rec_match

## Split a token interval at top-level commas. Empty interval = zero parts.
DEFine PROCedure rec_split(a,b)
  LOCal i,depth,start
  rs_n=0: start=a: depth=0
  IF b<a THEN RETurn
  FOR i=a TO b
    IF rec_token$(i)="(" THEN depth=depth+1
    IF rec_token$(i)=")" THEN depth=depth-1
    IF depth<0 THEN rec_fail "Unbalanced parentheses"
    IF rec_token$(i)="," AND depth=0 THEN
      IF rs_n=64 THEN rec_fail "Too many list items"
      rs_n=rs_n+1: rs_b(rs_n)=start: rs_e(rs_n)=i-1: start=i+1
    END IF
  END FOR i
  IF depth<>0 THEN rec_fail "Unbalanced parentheses"
  IF rs_n=64 THEN rec_fail "Too many list items"
  rs_n=rs_n+1: rs_b(rs_n)=start: rs_e(rs_n)=b
END DEFine rec_split

REFERENCE names$(0,0)
DEFine FuNction rec_find(name$,names$,count)
  LOCal i,key$(160)
  key$=rec_upper$(name$)
  FOR i=1 TO count
    IF key$=names$(i) THEN RETurn i
  END FOR i
  RETurn 0
END DEFine rec_find

DEFine FuNction rec_num$(value)
  RETurn rec_trim$(value & "")
END DEFine rec_num$

DEFine FuNction rec_join$(a$,b$)
  IF a$="" THEN RETurn b$
  IF b$="" THEN RETurn a$
  RETurn a$ & "," & b$
END DEFine rec_join$

DEFine FuNction rec_dims$(rank)
  LOCal i,s$(1024)
  s$=""
  FOR i=1 TO rank
    s$=rec_join$(s$,"0")
  END FOR i
  IF rank=0 THEN RETurn ""
  RETurn "(" & s$ & ")"
END DEFine rec_dims$

DEFine FuNction rec_name$(variable,leaf)
  RETurn rv_name$(variable) & "_" & rl_path$(leaf)
END DEFine rec_name$

DEFine FuNction rec_access$(variable,leaf,indices$)
  LOCal s$(1024)
  s$=rec_name$(variable,leaf)
  IF indices$<>"" THEN s$=s$ & "(" & indices$ & ")"
  RETurn s$
END DEFine rec_access$

## Never mutate string parameters: interpreted calls can alias source slices.
DEFine FuNction rec_upper$(source$)
  LOCal result$(1024),offset,codevalue
  result$=""
  FOR offset=1 TO LEN(source$)
    codevalue=CODE(source$(offset))
    IF codevalue>=97 AND codevalue<=122 THEN codevalue=codevalue-32
    result$=result$ & CHR$(codevalue)
  END FOR offset
  RETurn result$
END DEFine rec_upper$

DEFine FuNction rec_trim$(source$)
  LOCal first,last,i,result$(1024)
  first=1: last=LEN(source$): result$=""
  REPeat rec_trim_left
    IF first>last THEN RETurn ""
    IF source$(first)<>" " AND source$(first)<>CHR$(9) THEN EXIT rec_trim_left
    first=first+1
  END REPeat rec_trim_left
  REPeat rec_trim_right
    IF source$(last)<>" " AND source$(last)<>CHR$(9) THEN EXIT rec_trim_right
    last=last-1
  END REPeat rec_trim_right
  FOR i=first TO last
    result$=result$ & source$(i)
  END FOR i
  RETurn result$
END DEFine rec_trim$

DEFine FuNction rec_ltrim$(source$)
  LOCal first,i,result$(1024)
  first=1: result$=""
  REPeat rec_trim_leading
    IF first>LEN(source$) THEN RETurn ""
    IF source$(first)<>" " AND source$(first)<>CHR$(9) THEN EXIT rec_trim_leading
    first=first+1
  END REPeat rec_trim_leading
  FOR i=first TO LEN(source$)
    result$=result$ & source$(i)
  END FOR i
  RETurn result$
END DEFine rec_ltrim$
